@page "/auditlogs"
@using YbsSmartCardSystem.Contracts.Features.AuditLog
@implements IDisposable

<PageTitle>Audit Log</PageTitle>

<div class="page-header mb-4">
    <h1 class="page-title">Audit Log</h1>
    <p class="text-muted">Track all important system actions and changes.</p>
</div>

@if (!AuthState.IsAuthenticated || !AuthState.HasPermission("AuditLog.View"))
{
    <div class="alert alert-danger">You do not have permission to view audit logs.</div>
}
else
{
    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Action</label>
                    <input class="form-control" @bind="Request.Action" placeholder="e.g. Login, CreateCard" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Feature</label>
                    <input class="form-control" @bind="Request.FeatureName" placeholder="e.g. Card, Auth" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">From Date</label>
                    <input type="date" class="form-control" @bind="Request.FromDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">To Date</label>
                    <input type="date" class="form-control" @bind="Request.ToDate" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" @onclick="SearchAsync">Search</button>
                <button class="btn btn-outline-secondary" @onclick="ResetAsync">Reset</button>
            </div>
        </div>
    </div>

    <!-- Table -->
    @if (IsLoading)
    {
        <div class="text-center py-5"><span class="spinner-border text-primary"></span></div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }
    else if (Response?.Data?.Logs?.Count == 0)
    {
        <div class="alert alert-info">No audit logs found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Date / Time</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Feature</th>
                        <th>Entity</th>
                        <th>Entity ID</th>
                        <th>IP Address</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Response!.Data!.Logs)
                    {
                        <tr>
                            <td>@log.AuditLogId</td>
                            <td>@log.CreatedDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@(log.UserName ?? "-")</td>
                            <td><span class="badge bg-secondary">@log.Action</span></td>
                            <td>@log.FeatureName</td>
                            <td>@(log.EntityName ?? "-")</td>
                            <td>@(log.EntityId ?? "-")</td>
                            <td>@(log.IpAddress ?? "-")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(log.OldValue) || !string.IsNullOrEmpty(log.NewValue))
                                {
                                    <button class="btn btn-sm btn-outline-info"
                                            @onclick="() => ToggleDetails(log.AuditLogId)">
                                        @(ExpandedId == log.AuditLogId ? "Hide" : "View")
                                    </button>
                                }
                            </td>
                        </tr>
                        @if (ExpandedId == log.AuditLogId)
                        {
                            <tr class="table-light">
                                <td colspan="9">
                                    <div class="row">
                                        @if (!string.IsNullOrEmpty(log.OldValue))
                                        {
                                            <div class="col-md-6">
                                                <strong>Old Value:</strong>
                                                <pre class="bg-light p-2 rounded small mt-1">@log.OldValue</pre>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(log.NewValue))
                                        {
                                            <div class="col-md-6">
                                                <strong>New Value:</strong>
                                                <pre class="bg-light p-2 rounded small mt-1">@log.NewValue</pre>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(log.UserAgent))
                                        {
                                            <div class="col-12 mt-2">
                                                <small class="text-muted"><strong>User Agent:</strong> @log.UserAgent</small>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted">
                Total: @Response!.Data!.TotalCount rows &mdash; Page @Request.PageNo of @TotalPages
            </span>
            <div class="btn-group">
                <button class="btn btn-sm btn-outline-secondary" disabled="@(Request.PageNo <= 1)" @onclick="PrevPage">&#8592; Prev</button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(Request.PageNo >= TotalPages)" @onclick="NextPage">Next &#8594;</button>
            </div>
        </div>
    }
}
