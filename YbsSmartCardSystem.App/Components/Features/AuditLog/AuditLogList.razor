@page "/auditlogs"
@using YbsSmartCardSystem.Contracts.Features.AuditLog
@implements IDisposable

<PageTitle>Audit Log</PageTitle>

<PageHeader Title="System Audit Log" Subtitle="Track all important system actions and changes" />

@if (!AuthState.IsAuthenticated || !AuthState.HasPermission("AuditLog.View"))
{
    <div class="mb-6 p-4 rounded-xl bg-rose-50 text-rose-700 text-sm border border-rose-200 flex items-center gap-2">
        <span class="bi bi-exclamation-triangle"></span> You do not have permission to view audit logs.
    </div>
}
else
{
    <!-- Filters -->
    <!-- Filters -->
    <div class="mb-6 bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Action</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                        <span class="bi bi-activity"></span>
                    </span>
                    <input class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg pl-9 pr-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" @bind="Request.Action" placeholder="e.g. Login" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Feature</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                        <span class="bi bi-box"></span>
                    </span>
                    <input class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg pl-9 pr-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" @bind="Request.FeatureName" placeholder="e.g. Card, Auth" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">From Date</label>
                <div class="relative">
                    <input type="date" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" @bind="Request.FromDate" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">To Date</label>
                <div class="relative">
                    <input type="date" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" @bind="Request.ToDate" />
                </div>
            </div>
        </div>
        <div class="flex gap-2">
            <button class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm" @onclick="SearchAsync">
                <span class="bi bi-search me-2"></span> Search
            </button>
            <button class="inline-flex items-center px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg border border-slate-200 transition-colors shadow-sm" @onclick="ResetAsync">
                Reset
            </button>
        </div>
    </div>

    <!-- Table -->
    @if (IsLoading)
    {
        <div class="flex justify-center items-center py-12">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="mb-6 p-4 rounded-xl bg-rose-50 text-rose-700 text-sm border border-rose-200 flex items-center gap-2">
            <span class="bi bi-exclamation-triangle"></span> @ErrorMessage
        </div>
    }
    else if (Response?.Data?.Logs?.Count == 0)
    {
        <div class="bg-slate-50 p-8 rounded-2xl border border-slate-200 text-center">
            <span class="bi bi-file-earmark-text text-4xl text-slate-300 mb-3 block"></span>
            <h3 class="text-lg font-medium text-slate-900 mb-1">No Audit Logs Found</h3>
            <p class="text-slate-500 text-sm">There are no matching logs for the specified criteria.</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold tracking-wider">
                        <tr>
                            <th class="px-6 py-4">No</th>
                            <th class="px-6 py-4">Date / Time</th>
                            <th class="px-6 py-4">User</th>
                            <th class="px-6 py-4">Action</th>
                            <th class="px-6 py-4">Feature</th>
                            <th class="px-6 py-4">Entity</th>
                            <th class="px-6 py-4">Entity ID</th>
                            <th class="px-6 py-4">IP Address</th>
                            <th class="px-6 py-4">Details</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @{ int rowNo = (Request.PageNo - 1) * Request.PageSize; }
                        @foreach (var log in Response!.Data!.Logs)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4 text-slate-400 whitespace-nowrap">@(++rowNo)</td>
                                <td class="px-6 py-4 font-mono text-slate-700 whitespace-nowrap">@log.CreatedDateTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="px-6 py-4 font-medium text-slate-900 whitespace-nowrap">@(log.UserName ?? "-")</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium border @GetActionBadgeClass(log.Action)">
                                        <span class="bi @GetActionIcon(log.Action) text-[10px]"></span> @log.Action
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-200">
                                        <span class="bi bi-box text-[10px]"></span> @log.FeatureName
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-slate-500 whitespace-nowrap">@(log.EntityName ?? "-")</td>
                                <td class="px-6 py-4 font-mono text-slate-500 whitespace-nowrap">@(log.EntityId ?? "-")</td>
                                <td class="px-6 py-4 font-mono text-slate-500 whitespace-nowrap">@(log.IpAddress ?? "-")</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (!string.IsNullOrEmpty(log.OldValue) || !string.IsNullOrEmpty(log.NewValue))
                                    {
                                        <button class="inline-flex items-center justify-center gap-1.5 h-8 px-2.5 bg-[#f0f4ff] hover:bg-[#e1e9ff] text-[#0052cc] text-xs font-semibold rounded-lg border border-[#d2e0ff] transition-all duration-200 active:scale-95"
                                                @onclick="() => ToggleDetails(log.AuditLogId)">
                                            <span class="bi @(ExpandedId == log.AuditLogId ? "bi-chevron-up" : "bi-chevron-down") text-xs"></span>
                                            @(ExpandedId == log.AuditLogId ? "Hide" : "View")
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300">—</span>
                                    }
                                </td>
                            </tr>
                            @if (ExpandedId == log.AuditLogId)
                            {
                                <tr class="bg-slate-50 border-b border-slate-100">
                                    <td colspan="9" class="p-4">
                                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                            @if (!string.IsNullOrEmpty(log.OldValue))
                                            {
                                                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                                                    <strong class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 text-rose-500">Old Value</strong>
                                                    <pre class="bg-slate-50 p-3 rounded-lg text-xs font-mono text-slate-700 overflow-x-auto border border-slate-100 max-h-48 overflow-y-auto">@log.OldValue</pre>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(log.NewValue))
                                            {
                                                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                                                    <strong class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 text-emerald-500">New Value</strong>
                                                    <pre class="bg-slate-50 p-3 rounded-lg text-xs font-mono text-slate-700 overflow-x-auto border border-slate-100 max-h-48 overflow-y-auto">@log.NewValue</pre>
                                                </div>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(log.UserAgent))
                                        {
                                            <div class="mt-3 text-xs text-slate-500 flex items-start gap-2">
                                                <span class="bi bi-display mt-0.5"></span>
                                                <span class="font-mono">@log.UserAgent</span>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4">
                <span class="text-sm text-slate-500">
                    Total: <strong class="text-slate-900 font-semibold">@Response!.Data!.TotalCount</strong> rows &middot; 10 per page
                </span>
                <div class="flex items-center gap-2">
                    <button class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" disabled="@(Request.PageNo <= 1)" @onclick="PrevPage">
                        Previous
                    </button>
                    <span class="text-sm text-slate-600 font-medium px-2">Page @Request.PageNo of @TotalPages</span>
                    <button class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" disabled="@(Request.PageNo >= TotalPages)" @onclick="NextPage">
                        Next
                    </button>
                </div>
            </div>
        </div>
    }
}
