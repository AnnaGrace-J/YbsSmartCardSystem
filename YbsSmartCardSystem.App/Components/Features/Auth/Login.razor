@page "/login"
@layout YbsSmartCardSystem.App.Components.Layout.EmptyLayout
@using YbsSmartCardSystem.Contracts.Features.Auth
@inject YbsSmartCardSystem.App.Services.ApiService Api
@inject YbsSmartCardSystem.App.Services.AuthStateService AuthState
@inject NavigationManager NavManager

<div class="bg-surface-container min-h-screen flex items-center justify-center p-md font-body-md text-on-surface">
    <main class="w-full max-w-sm mx-auto">

        <div class="bg-surface-container-lowest rounded-lg shadow-sm border border-outline-variant p-md md:p-lg flex flex-col gap-md">

            <!-- Header -->
            <div class="text-center flex flex-col gap-sm items-center">
                <div class="w-10 h-10 bg-[#093072] rounded-full flex items-center justify-center text-white mb-1.5">
                    <span class="material-symbols-outlined" style="font-size: 22px; font-variation-settings: 'FILL' 1;">commute</span>
                </div>
                <h1 class="font-headline-md text-headline-md text-[#093072]">TransitPay</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">Welcome back. Sign in to your account.</p>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="flex items-start gap-2 p-3 rounded-md bg-error-container text-on-error-container font-body-md text-body-md">
                    <span class="material-symbols-outlined mt-0.5" style="font-size: 18px;">error</span>
                    <span>@ErrorMessage</span>
                </div>
            }

            <EditForm Model="@Model" OnValidSubmit="HandleSubmit" FormName="LoginForm">
                <AntiforgeryToken />
                <DataAnnotationsValidator />
                <div class="flex flex-col gap-md">
                    <!-- Phone Number -->
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-md text-label-md text-on-surface" for="login-phone">Phone Number</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <span class="material-symbols-outlined text-on-surface-variant" style="font-size: 20px;">phone</span>
                            </div>
                            <InputText id="login-phone" class="block w-full pl-10 pr-3 py-1.5 border border-outline-variant rounded-md bg-surface-bright text-on-surface focus:ring-2 focus:ring-[#093072] focus:border-[#093072] transition-colors placeholder:text-on-surface-variant/50 font-body-md"
                                       placeholder="e.g. 09123456789" @bind-Value="Model.PhoneNumber" />
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-md text-label-md text-on-surface" for="login-password">Password</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <span class="material-symbols-outlined text-on-surface-variant" style="font-size: 20px;">lock</span>
                            </div>
                            <InputText id="login-password" type="password" class="block w-full pl-10 pr-3 py-1.5 border border-outline-variant rounded-md bg-surface-bright text-on-surface focus:ring-2 focus:ring-[#093072] focus:border-[#093072] transition-colors placeholder:text-on-surface-variant/50 font-body-md"
                                       placeholder="••••••••" @bind-Value="Model.Password" />
                        </div>
                    </div>

                    <!-- Action -->
                    <button type="submit"
                            class="mt-sm w-full bg-[#093072] hover:bg-[#093072]/90 text-on-primary font-label-md text-label-md py-2.5 px-4 rounded-md transition-all duration-200 active:scale-95 shadow-sm flex items-center justify-center gap-2 disabled:opacity-60 disabled:pointer-events-none"
                            disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="inline-block animate-spin border-2 border-white border-t-transparent rounded-full w-4 h-4"></span>
                            <span>Signing in...</span>
                        }
                        else
                        {
                            <span>Sign In</span>
                            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
                        }
                    </button>
                </div>
            </EditForm>

            <!-- Footer -->
            <div class="text-center pt-sm border-t border-outline-variant/50">
                <p class="font-body-md text-body-md text-on-surface-variant">
                    Don't have an account?
                    <a class="text-[#093072] hover:text-[#093072]/80 font-label-md transition-colors" href="/register">Sign Up</a>
                </p>
            </div>
        </div>
    </main>
</div>
