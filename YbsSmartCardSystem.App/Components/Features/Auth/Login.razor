@page "/login"
@layout YbsSmartCardSystem.App.Components.Layout.EmptyLayout
@using YbsSmartCardSystem.Contracts.Features.Auth
@inject YbsSmartCardSystem.App.Services.ApiService Api
@inject YbsSmartCardSystem.App.Services.AuthStateService AuthState
@inject NavigationManager NavManager

<div class="relative min-h-screen bg-gradient-to-br from-[#eef1f9] via-[#dbe2f1] to-[#c3cee5] font-sans flex items-center justify-center p-6 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute -top-32 -left-24 w-80 h-80 rounded-full bg-sky-200/50 blur-3xl"></div>
        <div class="absolute -bottom-24 -right-20 w-80 h-80 rounded-full bg-indigo-200/40 blur-3xl"></div>
    </div>

    <main class="relative w-full max-w-sm mx-auto">
        <div class="bg-white rounded-2xl shadow-xl shadow-slate-300/40 border border-white/60 p-6 sm:p-8 flex flex-col gap-6">

            <!-- Header -->
            <div class="text-center flex flex-col gap-3 items-center">
                <div class="relative">
                    <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-amber-400 via-orange-400 to-rose-500 opacity-60 blur-[6px]"></div>
                    <div class="relative w-12 h-12 bg-gradient-to-br from-[#2a3450] to-[#20283c] rounded-full flex items-center justify-center border border-white/60 shadow-md">
                        <span class="material-symbols-outlined text-amber-300 drop-shadow" style="font-size: 22px;">commute</span>
                    </div>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-neutral-900 tracking-tight">TransitPay</h1>
                    <p class="text-sm text-neutral-500 mt-1">Welcome back. Sign in to your account.</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700">
                    <span class="bi bi-exclamation-triangle-fill mt-0.5 text-rose-500"></span>
                    <span class="text-sm font-medium">@ErrorMessage</span>
                </div>
            }

            <EditForm Model="@Model" OnValidSubmit="HandleSubmit" FormName="LoginForm">
                <AntiforgeryToken />
                <DataAnnotationsValidator />
                <div class="flex flex-col gap-4">
                    <!-- Phone Number -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-semibold text-neutral-500 uppercase tracking-wider" for="login-phone">Phone Number</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-neutral-400">
                                <span class="bi bi-phone"></span>
                            </span>
                            <InputText id="login-phone" class="w-full bg-white border border-neutral-200 text-neutral-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm"
                                       placeholder="e.g. 09123456789" @bind-Value="Model.PhoneNumber" />
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-semibold text-neutral-500 uppercase tracking-wider" for="login-password">Password</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-neutral-400">
                                <span class="bi bi-lock-fill"></span>
                            </span>
                            <InputText id="login-password" type="@(ShowPassword ? "text" : "password")" class="w-full bg-white border border-neutral-200 text-neutral-900 rounded-xl pl-10 pr-10 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm"
                                       placeholder="••••••••" @bind-Value="Model.Password" />
                            <button type="button" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-neutral-400 hover:text-neutral-600 transition-colors" @onclick="() => ShowPassword = !ShowPassword" aria-label="Toggle password visibility">
                                <span class="bi @(ShowPassword ? "bi-eye-slash" : "bi-eye")"></span>
                            </button>
                        </div>
                    </div>

                    <!-- Action -->
                    <button type="submit"
                            class="mt-1 w-full btn-primary font-semibold rounded-xl py-3 shadow-md shadow-slate-300/50 flex items-center justify-center gap-2"
                            disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="inline-block animate-spin border-2 border-white border-t-transparent rounded-full w-4 h-4"></span>
                            <span>Signing in...</span>
                        }
                        else
                        {
                            <span>Sign In</span>
                            <span class="bi bi-arrow-right"></span>
                        }
                    </button>
                </div>
            </EditForm>

            <!-- Footer -->
            <div class="text-center pt-4 border-t border-neutral-100">
                <p class="text-sm text-neutral-500">
                    Don't have an account?
                    <a class="text-amber-600 hover:text-amber-700 font-semibold transition-colors" href="/register">Sign Up</a>
                </p>
            </div>
        </div>
    </main>
</div>
