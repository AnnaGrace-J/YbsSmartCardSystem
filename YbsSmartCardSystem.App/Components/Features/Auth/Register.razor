@page "/register"
@layout YbsSmartCardSystem.App.Components.Layout.EmptyLayout
@using YbsSmartCardSystem.Contracts.Features.Auth
@inject YbsSmartCardSystem.App.Services.ApiService Api
@inject NavigationManager NavManager

<div class="bg-surface-container min-h-screen flex items-center justify-center p-md font-body-md text-on-surface">
    <main class="w-full max-w-sm mx-auto">

        <div class="bg-surface-container-lowest rounded-lg shadow-sm border border-outline-variant p-md md:p-lg flex flex-col gap-md">

            <!-- Header -->
            <div class="text-center flex flex-col gap-sm items-center">
                <div class="w-10 h-10 bg-[#222a3d] rounded-full flex items-center justify-center text-white mb-1.5">
                    <span class="material-symbols-outlined" style="font-size: 22px; font-variation-settings: 'FILL' 1;">commute</span>
                </div>
                <h1 class="font-headline-md text-headline-md text-[#222a3d]">TransitPay</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">Create your account for frictionless mobility.</p>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="flex items-start gap-2 p-3 rounded-md bg-error-container text-on-error-container font-body-md text-body-md">
                    <span class="material-symbols-outlined mt-0.5" style="font-size: 18px;">error</span>
                    <span>@ErrorMessage</span>
                </div>
            }

            @if (CurrentStep == 1)
            {
                <EditForm Model="@Model" OnValidSubmit="HandleSendOtp" FormName="RegisterForm">
                    <AntiforgeryToken />
                    <DataAnnotationsValidator />
                    <div class="flex flex-col gap-md">
                        <!-- Username -->
                        <div class="flex flex-col gap-xs">
                            <label class="font-label-md text-label-md text-on-surface" for="username">Username</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <span class="material-symbols-outlined text-on-surface-variant" style="font-size: 20px;">person</span>
                                </div>
                                <InputText id="username" class="block w-full pl-10 pr-3 py-1.5 border border-outline-variant rounded-md bg-surface-bright text-on-surface focus:ring-2 focus:ring-[#222a3d] focus:border-[#222a3d] transition-colors placeholder:text-on-surface-variant/50 font-body-md"
                                           placeholder="johndoe" @bind-Value="Model.UserName" />
                            </div>
                        </div>

                        <!-- Phone Number -->
                        <div class="flex flex-col gap-xs">
                            <label class="font-label-md text-label-md text-on-surface" for="phone">Phone Number</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <span class="material-symbols-outlined text-on-surface-variant" style="font-size: 20px;">phone</span>
                                </div>
                                <InputText id="phone" class="block w-full pl-10 pr-3 py-1.5 border border-outline-variant rounded-md bg-surface-bright text-on-surface focus:ring-2 focus:ring-[#222a3d] focus:border-[#222a3d] transition-colors placeholder:text-on-surface-variant/50 font-body-md"
                                           placeholder="e.g. 09123456789" @bind-Value="Model.PhoneNumber" />
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="flex flex-col gap-xs">
                            <label class="font-label-md text-label-md text-on-surface" for="password">Password</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <span class="material-symbols-outlined text-on-surface-variant" style="font-size: 20px;">lock</span>
                                </div>
                                <InputText id="password" type="password" class="block w-full pl-10 pr-3 py-1.5 border border-outline-variant rounded-md bg-surface-bright text-on-surface focus:ring-2 focus:ring-[#222a3d] focus:border-[#222a3d] transition-colors placeholder:text-on-surface-variant/50 font-body-md"
                                           placeholder="••••••••" @bind-Value="Model.Password" />
                            </div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="flex flex-col gap-xs">
                            <label class="font-label-md text-label-md text-on-surface" for="confirm_password">Confirm Password</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <span class="material-symbols-outlined text-on-surface-variant" style="font-size: 20px;">lock_reset</span>
                                </div>
                                <InputText id="confirm_password" type="password" class="block w-full pl-10 pr-3 py-1.5 border border-outline-variant rounded-md bg-surface-bright text-on-surface focus:ring-2 focus:ring-[#222a3d] focus:border-[#222a3d] transition-colors placeholder:text-on-surface-variant/50 font-body-md"
                                           placeholder="••••••••" @bind-Value="ConfirmPassword" />
                            </div>
                        </div>

                        <!-- Action -->
                        <button type="submit"
                                class="mt-sm w-full bg-[#222a3d] hover:bg-[#2d3650] text-on-primary font-label-md text-label-md py-2.5 px-4 rounded-md transition-all duration-200 active:scale-95 shadow-sm flex items-center justify-center gap-2 disabled:opacity-60 disabled:pointer-events-none"
                                disabled="@IsSubmitting">
                            @if (IsSubmitting)
                            {
                                <span class="inline-block animate-spin border-2 border-white border-t-transparent rounded-full w-4 h-4"></span>
                                <span>Sending...</span>
                            }
                            else
                            {
                                <span>Send OTP</span>
                                <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
            else if (CurrentStep == 2)
            {
                <!-- OTP verification -->
                <div class="text-center flex flex-col gap-sm items-center">
                    <div class="w-12 h-12 bg-secondary-container/50 rounded-full flex items-center justify-center text-secondary mb-2">
                        <span class="material-symbols-outlined" style="font-size: 26px; font-variation-settings: 'FILL' 1;">mark_email_read</span>
                    </div>
                    <p class="font-body-md text-body-md text-on-surface-variant">
                        We've sent a verification code to<br />
                        <strong class="text-on-surface">@Model.PhoneNumber</strong>
                    </p>
                </div>

                <EditForm Model="@Model" OnValidSubmit="HandleRegister" FormName="OtpForm">
                    <AntiforgeryToken />
                    <div class="flex flex-col gap-md">
                        <div class="flex flex-col gap-xs">
                            <label class="font-label-md text-label-md text-on-surface" for="otp">Verification Code</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <span class="material-symbols-outlined text-on-surface-variant" style="font-size: 20px;">pin</span>
                                </div>
                                <InputText id="otp" class="block w-full pl-10 pr-3 py-1.5 border border-outline-variant rounded-md bg-surface-bright text-on-surface focus:ring-2 focus:ring-[#222a3d] focus:border-[#222a3d] transition-colors placeholder:text-on-surface-variant/50 font-body-md tracking-[0.5em] text-center"
                                           placeholder="000000" @bind-Value="Model.OtpCode" maxlength="6" />
                            </div>
                        </div>

                        <button type="submit"
                                class="mt-sm w-full bg-[#222a3d] hover:bg-[#2d3650] text-on-primary font-label-md text-label-md py-2.5 px-4 rounded-md transition-all duration-200 active:scale-95 shadow-sm flex items-center justify-center gap-2 disabled:opacity-60 disabled:pointer-events-none"
                                disabled="@IsSubmitting">
                            @if (IsSubmitting)
                            {
                                <span class="inline-block animate-spin border-2 border-white border-t-transparent rounded-full w-4 h-4"></span>
                                <span>Verifying...</span>
                            }
                            else
                            {
                                <span>Verify & Register</span>
                                <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
                            }
                        </button>

                        <div class="text-center">
                            <button type="button" class="text-[#222a3d] hover:text-[#2d3650] font-label-md transition-colors" @onclick="() => CurrentStep = 1">
                                &larr; Back
                            </button>
                        </div>
                    </div>
                </EditForm>
            }

            <!-- Footer -->
            <div class="text-center pt-sm border-t border-outline-variant/50">
                <p class="font-body-md text-body-md text-on-surface-variant">
                    Already have an account?
                    <a class="text-[#222a3d] hover:text-[#2d3650] font-label-md transition-colors" href="/login">Log In</a>
                </p>
            </div>
        </div>
    </main>
</div>
