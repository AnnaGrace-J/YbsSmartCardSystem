@page "/register"
@layout YbsSmartCardSystem.App.Components.Layout.EmptyLayout
@using YbsSmartCardSystem.Contracts.Features.Auth
@inject YbsSmartCardSystem.App.Services.ApiService Api
@inject NavigationManager NavManager

<div class="relative min-h-screen bg-gradient-to-br from-[#eef1f9] via-[#dbe2f1] to-[#c3cee5] font-sans flex items-center justify-center p-6 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute -top-32 -left-24 w-80 h-80 rounded-full bg-sky-200/50 blur-3xl"></div>
        <div class="absolute -bottom-24 -right-20 w-80 h-80 rounded-full bg-indigo-200/40 blur-3xl"></div>
    </div>

    <main class="relative w-full max-w-sm mx-auto">
        <div class="bg-white rounded-2xl shadow-xl shadow-slate-300/40 border border-white/60 p-6 sm:p-8 flex flex-col gap-6">

            <!-- Header -->
            <div class="text-center flex flex-col gap-3 items-center">
                <div class="relative">
                    <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-amber-400 via-orange-400 to-rose-500 opacity-60 blur-[6px]"></div>
                    <div class="relative w-12 h-12 bg-gradient-to-br from-[#2a3450] to-[#20283c] rounded-full flex items-center justify-center border border-white/60 shadow-md">
                        <span class="material-symbols-outlined text-amber-300 drop-shadow" style="font-size: 22px;">commute</span>
                    </div>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-neutral-900 tracking-tight">TransitPay</h1>
                    <p class="text-sm text-neutral-500 mt-1">Create your account for frictionless mobility.</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700">
                    <span class="bi bi-exclamation-triangle-fill mt-0.5 text-rose-500"></span>
                    <span class="text-sm font-medium">@ErrorMessage</span>
                </div>
            }

            @if (CurrentStep == 1)
            {
                <EditForm Model="@Model" OnValidSubmit="HandleSendOtp" FormName="RegisterForm">
                    <AntiforgeryToken />
                    <DataAnnotationsValidator />
                    <div class="flex flex-col gap-4">
                        <!-- Username -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-semibold text-neutral-500 uppercase tracking-wider" for="username">Username</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-neutral-400">
                                    <span class="bi bi-person-fill"></span>
                                </span>
                                <InputText id="username" class="w-full bg-white border border-neutral-200 text-neutral-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm"
                                           placeholder="johndoe" @bind-Value="Model.UserName" />
                            </div>
                        </div>

                        <!-- Phone Number -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-semibold text-neutral-500 uppercase tracking-wider" for="phone">Phone Number</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-neutral-400">
                                    <span class="bi bi-phone"></span>
                                </span>
                                <InputText id="phone" class="w-full bg-white border border-neutral-200 text-neutral-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm"
                                           placeholder="e.g. 09123456789" @bind-Value="Model.PhoneNumber" />
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-semibold text-neutral-500 uppercase tracking-wider" for="password">Password</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-neutral-400">
                                    <span class="bi bi-lock-fill"></span>
                                </span>
                                <InputText id="password" type="password" class="w-full bg-white border border-neutral-200 text-neutral-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm"
                                           placeholder="••••••••" @bind-Value="Model.Password" />
                            </div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-semibold text-neutral-500 uppercase tracking-wider" for="confirm_password">Confirm Password</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-neutral-400">
                                    <span class="bi bi-shield-lock-fill"></span>
                                </span>
                                <InputText id="confirm_password" type="password" class="w-full bg-white border border-neutral-200 text-neutral-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm"
                                           placeholder="••••••••" @bind-Value="ConfirmPassword" />
                            </div>
                        </div>

                        <!-- Action -->
                        <button type="submit"
                                class="mt-1 w-full bg-gradient-to-br from-[#2a3450] to-[#20283c] hover:from-[#333f63] hover:to-[#262e44] text-white font-semibold rounded-xl py-3 shadow-md shadow-slate-300/50 transition-all duration-200 active:scale-[0.98] flex items-center justify-center gap-2 disabled:opacity-60 disabled:pointer-events-none"
                                disabled="@IsSubmitting">
                            @if (IsSubmitting)
                            {
                                <span class="inline-block animate-spin border-2 border-white border-t-transparent rounded-full w-4 h-4"></span>
                                <span>Sending...</span>
                            }
                            else
                            {
                                <span>Send OTP</span>
                                <span class="bi bi-arrow-right"></span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
            else if (CurrentStep == 2)
            {
                <!-- OTP verification -->
                <div class="text-center flex flex-col gap-3 items-center">
                    <div class="w-12 h-12 bg-emerald-100 border border-emerald-200 rounded-full flex items-center justify-center text-emerald-600">
                        <span class="bi bi-envelope-check-fill" style="font-size: 20px;"></span>
                    </div>
                    <p class="text-sm text-neutral-500">
                        We've sent a verification code to<br />
                        <strong class="text-neutral-900">@Model.PhoneNumber</strong>
                    </p>
                </div>

                <EditForm Model="@Model" OnValidSubmit="HandleRegister" FormName="OtpForm">
                    <AntiforgeryToken />
                    <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-semibold text-neutral-500 uppercase tracking-wider" for="otp">Verification Code</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-neutral-400">
                                    <span class="bi bi-shield-check"></span>
                                </span>
                                <InputText id="otp" class="w-full bg-white border border-neutral-200 text-neutral-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm tracking-[0.5em] text-center"
                                           placeholder="000000" @bind-Value="Model.OtpCode" maxlength="6" />
                            </div>
                        </div>

                        <button type="submit"
                                class="mt-1 w-full bg-gradient-to-br from-[#2a3450] to-[#20283c] hover:from-[#333f63] hover:to-[#262e44] text-white font-semibold rounded-xl py-3 shadow-md shadow-slate-300/50 transition-all duration-200 active:scale-[0.98] flex items-center justify-center gap-2 disabled:opacity-60 disabled:pointer-events-none"
                                disabled="@IsSubmitting">
                            @if (IsSubmitting)
                            {
                                <span class="inline-block animate-spin border-2 border-white border-t-transparent rounded-full w-4 h-4"></span>
                                <span>Verifying...</span>
                            }
                            else
                            {
                                <span>Verify & Register</span>
                                <span class="bi bi-arrow-right"></span>
                            }
                        </button>

                        <div class="text-center">
                            <button type="button" class="inline-flex items-center gap-1.5 text-amber-600 hover:text-amber-700 font-semibold transition-colors" @onclick="() => CurrentStep = 1">
                                <span class="bi bi-arrow-left"></span> Back
                            </button>
                        </div>
                    </div>
                </EditForm>
            }

            <!-- Footer -->
            <div class="text-center pt-4 border-t border-neutral-100">
                <p class="text-sm text-neutral-500">
                    Already have an account?
                    <a class="text-amber-600 hover:text-amber-700 font-semibold transition-colors" href="/login">Log In</a>
                </p>
            </div>
        </div>
    </main>
</div>
