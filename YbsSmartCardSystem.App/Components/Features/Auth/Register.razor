@page "/register"
@using YbsSmartCardSystem.Contracts.Features.Auth
@inject YbsSmartCardSystem.App.Services.ApiService Api
@inject NavigationManager NavManager

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 p-4">
    <div class="w-full max-w-md bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-3xl p-8 shadow-2xl transition-all duration-300 hover:shadow-indigo-500/10">
        
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-emerald-500 to-teal-500 mb-4 shadow-lg shadow-emerald-500/30">
                <span class="bi bi-person-plus-fill text-white text-2xl"></span>
            </div>
            <h2 class="text-2xl font-bold text-white tracking-tight">Create Account</h2>
            <p class="text-sm text-slate-400 mt-1">Join the YBS Smart Card System</p>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 flex items-start gap-3">
                <span class="bi bi-exclamation-triangle-fill text-rose-400 mt-0.5"></span>
                <span class="text-sm text-rose-300 font-medium">@ErrorMessage</span>
            </div>
        }

        @if (CurrentStep == 1)
        {
            <EditForm Model="@Model" OnValidSubmit="HandleSendOtp" FormName="RegisterForm">
                <AntiforgeryToken />
                <DataAnnotationsValidator />
                <div class="space-y-5">
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Username</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500">
                                <span class="bi bi-person-fill"></span>
                            </span>
                            <InputText class="w-full bg-slate-950/40 border border-white/10 text-white rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all duration-200 text-sm" 
                                       placeholder="Choose a username" @bind-Value="Model.UserName" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Phone Number</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500">
                                <span class="bi bi-telephone-fill"></span>
                            </span>
                            <InputText class="w-full bg-slate-950/40 border border-white/10 text-white rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all duration-200 text-sm" 
                                       placeholder="e.g. 09123456789" @bind-Value="Model.PhoneNumber" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Password</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500">
                                <span class="bi bi-lock-fill"></span>
                            </span>
                            <InputText type="password" class="w-full bg-slate-950/40 border border-white/10 text-white rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all duration-200 text-sm" 
                                       placeholder="Min. 6 characters" @bind-Value="Model.Password" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Confirm Password</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500">
                                <span class="bi bi-shield-lock-fill"></span>
                            </span>
                            <InputText type="password" class="w-full bg-slate-950/40 border border-white/10 text-white rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all duration-200 text-sm" 
                                       placeholder="Confirm your password" @bind-Value="ConfirmPassword" />
                        </div>
                    </div>

                    <div class="pt-2">
                        <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-semibold rounded-xl shadow-lg shadow-emerald-500/20 active:scale-[0.98] transition-all duration-200 disabled:opacity-50 disabled:pointer-events-none" 
                                disabled="@IsSubmitting">
                            @if (IsSubmitting)
                            {
                                <span class="inline-block animate-spin border-2 border-white border-t-transparent rounded-full w-4 h-4 mr-2 vertical-middle"></span>
                                <span>Sending OTP...</span>
                            }
                            else
                            {
                                <span>Send OTP</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        }
        else if (CurrentStep == 2)
        {
            <div class="text-center mb-6">
                <p class="text-slate-300 text-sm">We've sent a verification code to <br/> <strong class="text-white">@Model.PhoneNumber</strong></p>
            </div>
            
            <EditForm Model="@Model" OnValidSubmit="HandleRegister" FormName="OtpForm">
                <AntiforgeryToken />
                <div class="space-y-5">
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Verification Code</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500">
                                <span class="bi bi-chat-text-fill"></span>
                            </span>
                            <InputText class="w-full bg-slate-950/40 border border-white/10 text-white rounded-xl pl-10 pr-4 py-3 text-center tracking-[0.5em] font-mono text-lg focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all duration-200" 
                                       placeholder="000000" @bind-Value="Model.OtpCode" maxlength="6" />
                        </div>
                    </div>

                    <div class="pt-2">
                        <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-semibold rounded-xl shadow-lg shadow-emerald-500/20 active:scale-[0.98] transition-all duration-200 disabled:opacity-50 disabled:pointer-events-none" 
                                disabled="@IsSubmitting">
                            @if (IsSubmitting)
                            {
                                <span class="inline-block animate-spin border-2 border-white border-t-transparent rounded-full w-4 h-4 mr-2 vertical-middle"></span>
                                <span>Verifying...</span>
                            }
                            else
                            {
                                <span>Verify & Register</span>
                            }
                        </button>
                    </div>
                    
                    <div class="text-center mt-4">
                        <button type="button" class="text-slate-400 text-sm hover:text-white transition-colors" @onclick="() => CurrentStep = 1">
                            &larr; Back
                        </button>
                    </div>
                </div>
            </EditForm>
        }

        <div class="mt-6 text-center text-sm text-slate-400">
            Already have an account? 
            <a href="/login" class="text-emerald-400 font-semibold hover:text-emerald-300 transition-colors">Sign in here</a>
        </div>
    </div>
</div>
