@page "/dashboard"
@using YbsSmartCardSystem.Contracts.Features.Auth
@inject YbsSmartCardSystem.App.Services.ApiService Api
@inject YbsSmartCardSystem.App.Services.AuthStateService AuthState
@inject NavigationManager NavManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="p-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
        <div>
            <h1 class="text-3xl font-bold text-slate-800 tracking-tight">Dashboard</h1>
            <p class="text-slate-500 mt-1">Welcome back, <span class="font-semibold text-slate-700">@DashboardData?.UserName</span></p>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600"></div>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 flex items-start gap-3">
            <span class="bi bi-exclamation-triangle-fill text-rose-500 mt-0.5"></span>
            <span class="text-sm text-rose-700 font-medium">@ErrorMessage</span>
        </div>
    }
    else if (DashboardData != null)
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl">
                    <span class="bi bi-person-fill"></span>
                </div>
                <div>
                    <p class="text-sm font-medium text-slate-500">Username</p>
                    <p class="text-lg font-bold text-slate-800">@DashboardData.UserName</p>
                </div>
            </div>
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                    <span class="bi bi-telephone-fill"></span>
                </div>
                <div>
                    <p class="text-sm font-medium text-slate-500">Phone Number</p>
                    <p class="text-lg font-bold text-slate-800">@DashboardData.PhoneNumber</p>
                </div>
            </div>
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200/60 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center text-xl">
                    <span class="bi bi-credit-card-fill"></span>
                </div>
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Cards</p>
                    <p class="text-lg font-bold text-slate-800">@DashboardData.Cards.Count</p>
                </div>
            </div>
        </div>

        <h2 class="text-xl font-bold text-slate-800 mb-4">Your Cards</h2>
        
        @if (DashboardData.Cards.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var card in DashboardData.Cards)
                {
                    <div class="bg-gradient-to-br from-slate-900 to-slate-800 rounded-2xl p-6 shadow-lg border border-slate-700 relative overflow-hidden group hover:shadow-xl transition-all duration-300">
                        <!-- Card UI -->
                        <div class="absolute top-0 right-0 p-4 opacity-10 pointer-events-none">
                            <span class="bi bi-credit-card-2-front-fill text-9xl text-white"></span>
                        </div>
                        
                        <div class="relative z-10 flex justify-between items-start mb-8">
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 rounded bg-yellow-500/20 flex items-center justify-center">
                                    <span class="bi bi-cpu text-yellow-500"></span>
                                </div>
                                <span class="text-slate-300 font-medium text-sm tracking-widest">YBS SMART CARD</span>
                            </div>
                            <span class="bi bi-wifi text-slate-400 text-xl"></span>
                        </div>
                        
                        <div class="relative z-10 space-y-4">
                            <div>
                                <p class="text-slate-400 text-xs uppercase tracking-wider font-semibold mb-1">Card Number</p>
                                <p class="text-white font-mono text-xl tracking-wider">@card.CardNum</p>
                            </div>
                            
                            <div class="flex justify-between items-end pt-2">
                                <div>
                                    <p class="text-slate-400 text-xs uppercase tracking-wider font-semibold mb-1">Card Holder</p>
                                    <p class="text-white font-medium uppercase">@card.OwnerName</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-slate-400 text-xs uppercase tracking-wider font-semibold mb-1">Balance</p>
                                    <p class="text-emerald-400 font-bold text-lg">@card.Balance.ToString("C0")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-2xl p-12 shadow-sm border border-slate-200/60 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-slate-100 text-slate-400 mb-4">
                    <span class="bi bi-credit-card text-2xl"></span>
                </div>
                <h3 class="text-lg font-bold text-slate-800">No Cards Found</h3>
                <p class="text-slate-500 mt-1 max-w-sm mx-auto">No card has been registered for your phone number yet.</p>
            </div>
        }
    }
</div>
