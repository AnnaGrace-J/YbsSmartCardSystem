@page "/dashboard"
@using YbsSmartCardSystem.Contracts.Features.Auth
@inject YbsSmartCardSystem.App.Services.ApiService Api
@inject YbsSmartCardSystem.App.Services.AuthStateService AuthState
@inject NavigationManager NavManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize]


<div class="max-w-5xl mx-auto p-3 sm:p-4 flex flex-col gap-4">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-2">
        <PageHeader Title="Dashboard" Subtitle="@($"Welcome back, {DashboardData?.UserName}")" />
        @if (DashboardData != null && DashboardData.Cards.Any())
        {
            <div class="bg-neutral-100/60 border border-neutral-200/80 rounded-md p-2 px-3 flex items-center gap-2.5 shadow-xs">
                <div class="w-7 h-7 rounded-md bg-neutral-200/50 flex items-center justify-center text-neutral-700">
                    <span class="bi bi-wallet2 text-xs"></span>
                </div>
                <div>
                    <span class="block text-[10px] font-semibold text-neutral-500 uppercase tracking-wider leading-none mb-0.5">Available Balance</span>
                    <span class="text-sm font-bold text-neutral-900 leading-none">
                        @FormatBalance(DashboardData.Cards.First().Balance)
                    </span>
                </div>
            </div>
        }
    </div>

    @if (IsLoading)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-neutral-900"></div>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="p-3 rounded-md bg-red-50 border border-red-200 flex items-start gap-2.5">
            <span class="bi bi-exclamation-triangle-fill text-red-500 mt-0.5 text-xs"></span>
            <span class="text-xs text-red-700 font-medium">@ErrorMessage</span>
        </div>
    }
    else if (DashboardData != null)
    {
        <!-- Alert Feedback Message -->
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="p-3 rounded-md border flex items-center justify-between transition-all @(isSuccess ? "bg-emerald-50 border-emerald-200/60 text-emerald-800" : "bg-red-50 border-red-200/60 text-red-800") shadow-xs">
                <div class="flex items-center gap-2.5">
                    <span class="bi @(isSuccess ? "bi-check-circle-fill text-emerald-500" : "bi-exclamation-triangle-fill text-red-500") text-sm"></span>
                    <span class="text-xs font-semibold">@message</span>
                </div>
                <button class="text-neutral-400 hover:text-neutral-600 transition-colors" @onclick="() => message = null">
                    <span class="bi bi-x-lg text-xs"></span>
                </button>
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <StatCard Title="Username" Value="@DashboardData.UserName" IconClass="bi bi-person-fill" IconBgClass="bg-sky-50 dark:bg-sky-950/40" IconTextClass="text-sky-600 dark:text-sky-400" />
            <StatCard Title="Phone Number" Value="@DashboardData.PhoneNumber" IconClass="bi bi-telephone-fill" IconBgClass="bg-emerald-50 dark:bg-emerald-950/40" IconTextClass="text-emerald-600 dark:text-emerald-400" />
            <StatCard Title="Total Cards" Value="@DashboardData.Cards.Count.ToString()" IconClass="bi bi-credit-card-fill" IconBgClass="bg-amber-50 dark:bg-amber-950/40" IconTextClass="text-amber-600 dark:text-amber-400" />
        </div>

        @if (DashboardData.Cards.Any())
        {
            var card = DashboardData.Cards.First();
            
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
                
                <!-- Card Visual Column (5 cols) -->
                <div class="lg:col-span-5 space-y-4">
                    <div class="bg-white border border-neutral-200/80 rounded-md p-3 sm:p-4 shadow-xs">
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-wider">Your Card</span>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60">Active</span>
                        </div>
                        
                        <!-- Visual Card (TransitPay Card matching Homepage mockup exactly) -->
                        <div class="relative w-full max-w-sm bg-gradient-to-br from-primary to-inverse-surface rounded-2xl p-6 sm:p-7 text-on-primary shadow-lg overflow-hidden transition-all duration-150 hover:scale-[1.01] active:scale-[0.99]">
                            <div class="relative flex justify-between items-start">
                                <div>
                                    <span class="font-label-sm text-label-sm tracking-widest text-on-primary/70 uppercase">TransitPay</span>
                                    <h3 class="font-headline-md text-headline-md mt-1">Commuter Card</h3>
                                </div>
                                <span class="material-symbols-outlined text-on-primary/90" style="font-size: 26px;">nfc</span>
                            </div>

                            <div class="relative mt-8 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div class="w-10 h-8 rounded-md bg-gradient-to-br from-amber-200 to-amber-400 border border-amber-500/50 relative overflow-hidden">
                                        <div class="absolute inset-0 flex flex-col justify-between p-[3px] opacity-70">
                                            <div class="h-px bg-amber-800/50"></div>
                                            <div class="h-px bg-amber-800/50"></div>
                                        </div>
                                    </div>
                                    <span class="material-symbols-outlined text-on-primary/80" style="font-size: 22px;">contactless</span>
                                </div>
                                <div class="text-right">
                                    <p class="font-label-sm text-label-sm text-on-primary/60">Balance</p>
                                    <p class="font-headline-md text-headline-md">@FormatBalance(card.Balance)</p>
                                </div>
                            </div>

                            <div class="relative mt-8 flex justify-between items-end">
                                <div>
                                    <p class="font-label-sm text-label-sm text-on-primary/60">Cardholder</p>
                                    <p class="font-label-md text-label-md mt-0.5">@card.OwnerName</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-label-sm text-label-sm text-on-primary/60">Card Number</p>
                                    <p class="font-mono font-label-md text-label-md mt-0.5 tracking-widest">@FormatCardNum(card.CardNum)</p>
                                </div>
                            </div>
                        </div>

                        <!-- Card Quick Details Info list -->
                        <div class="mt-3 space-y-2 border-t border-neutral-200/60 pt-3">
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-neutral-500 font-medium">Card Number</span>
                                <span class="font-mono text-neutral-800 font-semibold">@card.CardNum</span>
                            </div>
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-neutral-500 font-medium">Holder Name</span>
                                <span class="text-neutral-800 font-semibold">@card.OwnerName</span>
                            </div>
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-neutral-500 font-medium">Registered Phone</span>
                                <span class="font-mono text-neutral-800 font-semibold">@card.MobileNo</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions / Controls Column (7 cols) -->
                <div class="lg:col-span-7 space-y-4">
                    <!-- Card Management Card -->
                    <div class="bg-white border border-neutral-200/80 rounded-md p-3 sm:p-4 shadow-xs">
                        <h2 class="text-sm font-semibold text-neutral-800 mb-3 flex items-center gap-1.5">
                            <span class="bi bi-shield-check text-neutral-600 text-sm"></span>
                            <span>Card Control Center</span>
                        </h2>
                        
                        <div class="flex items-center gap-2">
                            <button class="h-8 px-3 text-xs font-medium text-white bg-neutral-900 hover:bg-neutral-800 rounded-md shadow-xs transition-all active:scale-[0.98] flex items-center gap-1.5"
                                    @onclick="() => showTopUpModal = true">
                                <i class="bi bi-cash-stack"></i>
                                <span>Add Funds</span>
                            </button>

                            <button class="h-8 px-3 text-xs font-medium bg-neutral-100 text-neutral-700 hover:bg-neutral-200/80 border border-neutral-200/60 rounded-md transition-all active:scale-[0.98] flex items-center gap-1.5"
                                    @onclick="OpenRenameModal">
                                <i class="bi bi-pencil-square"></i>
                                <span>Rename Card</span>
                            </button>
                            
                            <button class="h-8 px-3 text-xs font-medium text-red-600 bg-red-50 hover:bg-red-100 rounded-md transition-all active:scale-[0.98] flex items-center gap-1.5 ml-auto"
                                    @onclick="ReportLost">
                                <i class="bi bi-shield-slash"></i>
                                <span>Deactivate / Lost</span>
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        }
        else
        {
            <!-- Empty State / Link Card -->
            <div class="bg-white border border-neutral-200/80 rounded-md p-6 text-center max-w-md mx-auto shadow-xs">
                <div class="w-12 h-12 bg-neutral-100 text-neutral-600 rounded-md flex items-center justify-center mx-auto mb-4">
                    <span class="bi bi-credit-card-2-front-fill text-xl"></span>
                </div>
                <h3 class="text-base font-semibold text-neutral-950 mb-1">No Registered Card Found</h3>
                <p class="text-xs text-neutral-500 mb-4 leading-normal">
                    There are no cards registered to your phone number. Register your physical card now to activate virtual wallet access.
                </p>
                <div class="flex flex-col sm:flex-row gap-2 justify-center">
                </div>
            </div>
        }
    }
</div>

<!-- ============================================== -->
<!-- MODALS SECTION                                 -->
<!-- ============================================== -->

<!-- 1. Rename Card Modal -->
@if (showRenameModal)
{
    <div class="fixed inset-0 bg-neutral-950/40 backdrop-blur-xs z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-md shadow-md border border-neutral-200/80 max-w-sm w-full p-4 animate-in fade-in duration-100">
            <div class="flex justify-between items-start mb-3">
                <h3 class="text-sm font-semibold text-neutral-900">Rename Card Owner</h3>
                <button class="text-neutral-400 hover:text-neutral-600" @onclick="() => showRenameModal = false">
                    <span class="bi bi-x-lg text-xs"></span>
                </button>
            </div>
            
            <div class="flex flex-col gap-1 mb-4">
                <label class="text-[11px] font-medium text-neutral-600">New Owner Name</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-2.5 flex items-center text-neutral-400">
                        <span class="bi bi-person text-xs"></span>
                    </span>
                    <input class="w-full h-8 bg-white border border-neutral-200 rounded-md pl-8 pr-2.5 text-xs text-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900 focus:border-neutral-900 transition-all placeholder:text-neutral-400"
                           type="text" maxlength="100" @bind="newOwnerName" placeholder="Enter owner name" />
                </div>
            </div>

            <div class="flex justify-end gap-2">
                <button class="h-8 px-3 text-xs font-medium text-neutral-600 hover:bg-neutral-100 rounded-md transition-colors active:scale-[0.98]"
                        @onclick="() => showRenameModal = false" disabled="@isRenaming">
                    Cancel
                </button>
                <button class="h-8 px-3 text-xs font-medium text-white bg-neutral-900 hover:bg-neutral-800 rounded-md shadow-xs transition-all active:scale-[0.98] flex items-center gap-1.5 disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none"
                        @onclick="RenameCard" disabled="@(isRenaming || string.IsNullOrWhiteSpace(newOwnerName))">
                    @if (isRenaming)
                    {
                        <span class="animate-spin h-3 w-3 border-2 border-white border-t-transparent rounded-full"></span>
                    }
                    Save Changes
                </button>
            </div>
        </div>
    </div>
}

<!-- 2. Add Funds Modal -->
@if (showTopUpModal)
{
    <div class="fixed inset-0 bg-neutral-950/40 backdrop-blur-xs z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-md shadow-md border border-neutral-200/80 max-w-sm w-full p-4 animate-in fade-in duration-100">
            <div class="flex justify-between items-start mb-3">
                <h3 class="text-sm font-semibold text-neutral-900">Add Funds to Card</h3>
                <button class="text-neutral-400 hover:text-neutral-600" @onclick="() => showTopUpModal = false">
                    <span class="bi bi-x-lg text-xs"></span>
                </button>
            </div>

            <!-- Top Up Amount Selections -->
            <div class="flex flex-col gap-3.5 mb-4">
                <div>
                    <label class="text-[11px] font-medium text-neutral-600 block mb-1">Select Amount</label>
                    <div class="grid grid-cols-2 gap-2">
                        <button class="h-8 rounded-md border text-xs font-semibold transition-all active:scale-[0.98] @(topUpAmount == 5000 ? "bg-neutral-100 border-neutral-400 text-neutral-900" : "bg-neutral-50 border-neutral-200/60 text-neutral-700 hover:bg-neutral-100")"
                                @onclick="() => topUpAmount = 5000">
                            5,000 MMK
                        </button>
                        <button class="h-8 rounded-md border text-xs font-semibold transition-all active:scale-[0.98] @(topUpAmount == 10000 ? "bg-neutral-100 border-neutral-400 text-neutral-900" : "bg-neutral-50 border-neutral-200/60 text-neutral-700 hover:bg-neutral-100")"
                                @onclick="() => topUpAmount = 10000">
                            10,000 MMK
                        </button>
                        <button class="h-8 rounded-md border text-xs font-semibold transition-all active:scale-[0.98] @(topUpAmount == 20000 ? "bg-neutral-100 border-neutral-400 text-neutral-900" : "bg-neutral-50 border-neutral-200/60 text-neutral-700 hover:bg-neutral-100")"
                                @onclick="() => topUpAmount = 20000">
                            20,000 MMK
                        </button>
                        <button class="h-8 rounded-md border text-xs font-semibold transition-all active:scale-[0.98] @(topUpAmount == 50000 ? "bg-neutral-100 border-neutral-400 text-neutral-900" : "bg-neutral-50 border-neutral-200/60 text-neutral-700 hover:bg-neutral-100")"
                                @onclick="() => topUpAmount = 50000">
                            50,000 MMK
                        </button>
                    </div>
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-[11px] font-medium text-neutral-600">Custom Amount (MMK)</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-2.5 flex items-center text-neutral-400 text-xs font-semibold">MMK</span>
                        <input class="w-full h-8 bg-white border border-neutral-200 rounded-md pl-10 pr-2.5 text-xs text-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900 focus:border-neutral-900 transition-all font-semibold"
                               type="number" step="500" min="500" @bind="topUpAmount" placeholder="Enter amount" />
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-2">
                <button class="h-8 px-3 text-xs font-medium text-neutral-600 hover:bg-neutral-100 rounded-md transition-colors active:scale-[0.98]"
                        @onclick="() => showTopUpModal = false" disabled="@isToppingUp">
                    Cancel
                </button>
                <button class="h-8 px-3 text-xs font-medium text-white bg-neutral-900 hover:bg-neutral-800 rounded-md shadow-xs transition-all active:scale-[0.98] flex items-center gap-1.5 disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none"
                        @onclick="SubmitTopUp" disabled="@(isToppingUp || topUpAmount <= 0)">
                    @if (isToppingUp)
                    {
                        <span class="animate-spin h-3 w-3 border-2 border-white border-t-transparent rounded-full"></span>
                    }
                    Confirm Deposit
                </button>
            </div>
        </div>
    </div>
}

<!-- 3. Deactivate / Lost Modal -->
@if (showDeactivateModal)
{
    <div class="fixed inset-0 bg-neutral-950/40 backdrop-blur-xs z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-md shadow-md border border-neutral-200/80 max-w-sm w-full p-4 animate-in fade-in duration-100">
            <div class="flex justify-between items-start mb-2">
                <h3 class="text-sm font-semibold text-neutral-900 flex items-center gap-1.5">
                    <span class="bi bi-exclamation-triangle-fill text-red-500 text-sm"></span>
                    Deactivate Smart Card?
                </h3>
                <button class="text-neutral-400 hover:text-neutral-600" @onclick="() => showDeactivateModal = false">
                    <span class="bi bi-x-lg text-xs"></span>
                </button>
            </div>
            
            <p class="text-xs text-neutral-500 mb-4 leading-normal">
                WARNING: Reporting this card as lost will permanently deactivate it. All card details will be cleared and this action cannot be undone. Are you sure you want to proceed?
            </p>

            <div class="flex justify-end gap-2">
                <button class="h-8 px-3 text-xs font-medium text-neutral-600 hover:bg-neutral-100 rounded-md transition-colors active:scale-[0.98]"
                        @onclick="() => showDeactivateModal = false">
                    Cancel
                </button>
                <button class="h-8 px-3 text-xs font-medium text-red-600 bg-red-50 hover:bg-red-100 rounded-md transition-all active:scale-[0.98] flex items-center gap-1.5"
                        @onclick="ConfirmReportLost">
                    Confirm Deactivate
                </button>
            </div>
        </div>
    </div>
}
