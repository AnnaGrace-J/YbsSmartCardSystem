@page "/dashboard"
@using YbsSmartCardSystem.Contracts.Features.Auth
@inject YbsSmartCardSystem.App.Services.ApiService Api
@inject YbsSmartCardSystem.App.Services.AuthStateService AuthState
@inject NavigationManager NavManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="p-6">
    <PageHeader Title="Dashboard" Subtitle="@($"Welcome back, {DashboardData?.UserName}")" />

    @if (IsLoading)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600"></div>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 flex items-start gap-3">
            <span class="bi bi-exclamation-triangle-fill text-rose-500 mt-0.5"></span>
            <span class="text-sm text-rose-700 font-medium">@ErrorMessage</span>
        </div>
    }
    else if (DashboardData != null)
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <StatCard Title="Username" Value="@DashboardData.UserName" IconClass="bi bi-person-fill" />
            <StatCard Title="Phone Number" Value="@DashboardData.PhoneNumber" IconClass="bi bi-telephone-fill" />
            <StatCard Title="Total Cards" Value="@DashboardData.Cards.Count.ToString()" IconClass="bi bi-credit-card-fill" />
        </div>

        <h2 class="text-xl font-bold text-slate-900 mb-4">Your Card</h2>
        
        @if (DashboardData.Cards.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var card in DashboardData.Cards)
                {
                    <div class="bg-gradient-to-br from-blue-700 to-indigo-900 rounded-[20px] p-6 shadow-[0_8px_30px_rgb(6,81,237,0.2)] border border-white/10 relative overflow-hidden group">
                        <!-- Card UI -->
                        <div class="absolute top-0 right-0 p-4 opacity-5 pointer-events-none">
                            <span class="bi bi-credit-card-2-front-fill text-9xl text-white"></span>
                        </div>
                        
                        <div class="relative z-10 flex justify-between items-start mb-10">
                            <div class="flex items-center gap-2">
                                <div class="w-10 h-10 rounded bg-white/10 flex items-center justify-center backdrop-blur-md">
                                    <span class="bi bi-layers-fill text-white"></span>
                                </div>
                                <span class="text-white/80 font-medium text-sm tracking-widest">YBS TRANSIT</span>
                            </div>
                            <span class="bi bi-wifi text-white/50 text-xl"></span>
                        </div>
                        
                        <div class="relative z-10 space-y-4">
                            <div>
                                <p class="text-white/50 text-[10px] uppercase tracking-[0.2em] font-semibold mb-1">Card Number</p>
                                <p class="text-white font-mono text-xl tracking-[0.15em]">@card.CardNum</p>
                            </div>
                            
                            <div class="flex justify-between items-end pt-4">
                                <div>
                                    <p class="text-white/50 text-[10px] uppercase tracking-[0.2em] font-semibold mb-1">Card Holder</p>
                                    <p class="text-white font-medium uppercase tracking-wider text-sm">@card.OwnerName</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-white/50 text-[10px] uppercase tracking-[0.2em] font-semibold mb-1">Balance</p>
                                    <p class="text-teal-300 font-bold text-2xl tracking-tight">@card.Balance.ToString("C0")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-2xl p-12 shadow-sm border border-slate-200/60 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-slate-100 text-slate-400 mb-4">
                    <span class="bi bi-credit-card text-2xl"></span>
                </div>
                <h3 class="text-lg font-bold text-slate-800">No Cards Found</h3>
                <p class="text-slate-500 mt-1 max-w-sm mx-auto">No card has been registered for your phone number yet.</p>
            </div>
        }
    }
</div>
