@page "/bus/new"

<PageHeader Title="Register Bus" Subtitle="Add a new bus to the fleet" />

<div class="max-w-2xl mt-6">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 md:p-8">
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="mb-6 p-4 rounded-xl @(isSuccess ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-rose-50 text-rose-700 border-rose-200") border flex items-start gap-3">
                    <span class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") mt-0.5"></span>
                    <span class="text-sm font-medium">@message</span>
                </div>
            }

            <div class="space-y-5">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Bus Number <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <span class="bi bi-hash"></span>
                        </span>
                        <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm" type="text" maxlength="50" @bind="request.BusNo" placeholder="e.g. YGN-123" />
                    </div>
                </div>
                
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Bus License <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <span class="bi bi-card-text"></span>
                        </span>
                        <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm" type="text" maxlength="50" @bind="request.BusLicense" placeholder="e.g. AA-1234" />
                    </div>
                </div>

                <div class="flex gap-3 pt-4 border-t border-slate-100">
                    <button class="flex-1 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl shadow-sm transition-all duration-200 disabled:opacity-50" @onclick="Save" disabled="@isSaving">
                        @(isSaving ? "Saving…" : "Save Bus")
                    </button>
                    <NavLink class="px-6 py-3 bg-white hover:bg-slate-50 text-slate-700 font-medium rounded-xl border border-slate-200 shadow-sm transition-all duration-200 text-center" href="/buses">
                        Cancel
                    </NavLink>
                </div>
            </div>
        </div>
    </div>
</div>
