@page "/bus/new"
@rendermode InteractiveServer

<h4>New Bus</h4>


@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger")">@message</div>
}

<div class="mb-2">
    <label>Bus Number <span class="text-danger">*</span></label>
    <input class="form-control" type="text" maxlength="50" @bind="request.BusNo" />
</div>
<div class="mb-2">
    <label>Bus License <span class="text-danger">*</span></label>
    <input class="form-control" type="text" maxlength="50" @bind="request.BusLicense" />
</div>

<button class="btn btn-success" @onclick="Save" disabled="@isSaving">
    @(isSaving ? "Saving…" : "Save")
</button>
<NavLink class="btn btn-outline-secondary ms-2" href="/buses">Cancel</NavLink>
