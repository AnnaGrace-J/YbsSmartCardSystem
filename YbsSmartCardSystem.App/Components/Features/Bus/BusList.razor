@page "/buses"
@inject YbsSmartCardSystem.App.Services.AuthStateService AuthState

<PageHeader Title="Bus Fleet Registry" Subtitle="Manage transit buses and assignments">
    @if (AuthState.HasPermission("Bus.Create"))
    {
        <NavLink class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-xl transition-colors shadow-sm" href="/bus/new">
            <span class="bi bi-plus-lg"></span> Register Bus
        </NavLink>
    }
</PageHeader>

<div class="mb-6 flex flex-col md:flex-row gap-3">
    <div class="relative flex-1 max-w-md">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
            <span class="bi bi-search"></span>
        </span>
        <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg pl-10 pr-4 py-2.5 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm shadow-sm" 
               placeholder="Search by Bus No or Bus License..." @bind="searchText" @onkeyup="@(e => e.Key == "Enter" ? Search() : Task.CompletedTask)" />
    </div>
    <div class="relative w-full sm:w-48">
        <select class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm shadow-sm"
                @bind="StatusFilter" @bind:after="Search">
            <option value="active">Active Buses</option>
            <option value="inactive">Inactive Buses</option>
            <option value="all">All Buses</option>
        </select>
    </div>
    <button class="inline-flex items-center justify-center px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded-lg transition-colors border border-slate-200 shadow-sm" @onclick="Search">
        Search
    </button>
</div>

@if (editingBusId is not null)
{
    <div class="bg-slate-50 rounded-xl p-6 mb-6 border border-slate-200 shadow-sm max-w-3xl">
        <h5 class="text-lg font-semibold text-slate-900 mb-4">Edit Bus Details</h5>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="mb-4 p-3 rounded-lg bg-rose-50 text-rose-700 text-sm border border-rose-200 flex items-center gap-2">
                <span class="bi bi-exclamation-triangle"></span> @message
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Bus Number</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                        <span class="bi bi-hash"></span>
                    </span>
                    <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg pl-9 pr-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" type="text" maxlength="50" @bind="editBus.BusNo" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Bus License</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                        <span class="bi bi-card-text"></span>
                    </span>
                    <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg pl-9 pr-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" type="text" maxlength="50" @bind="editBus.BusLicense" />
                </div>
            </div>
        </div>

        <div class="flex gap-3">
            <button class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" @onclick="UpdateBus" disabled="@isSaving">
                @(isSaving ? "Saving…" : "Update")
            </button>
            <button class="inline-flex items-center px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg border border-slate-200 transition-colors shadow-sm disabled:opacity-50" @onclick="CancelEdit" disabled="@isSaving">
                Cancel
            </button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(message) && editingBusId is null)
{
    <div class="mb-6 p-4 rounded-xl bg-blue-50 text-blue-700 text-sm border border-blue-200 flex items-center gap-2">
        <span class="bi bi-info-circle"></span> @message
    </div>
}

@if (response.IsSuccess)
{
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold tracking-wider">
                    <tr>
                        <th class="px-6 py-4 w-40">Actions</th>
                        <th class="px-6 py-4">No</th>
                        <th class="px-6 py-4">Bus No</th>
                        <th class="px-6 py-4">Bus License</th>
                        <th class="px-6 py-4">Created By</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (response.Data is not null)
                    {
                        var startNo = (request.PageNo - 1) * request.PageSize;
                        @for (var i = 0; i < response.Data.Buses.Count; i++)
                        {
                            var item = response.Data.Buses[i];
                            var itemIndex = i;
                            <tr class="hover:bg-slate-50/50 transition-colors @(editingBusId == item.BusId ? "bg-amber-50" : "")">
                                <td class="px-6 py-4">
                                    @if (AuthState.HasPermission("Bus.Update") || AuthState.HasPermission("Bus.Delete"))
                                    {
                                        <div class="flex items-center gap-2">
                                            @if (AuthState.HasPermission("Bus.Update"))
                                            {
                                                <button class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 hover:border-amber-400 hover:text-amber-600 text-slate-600 text-xs font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50"
                                                        @onclick="() => EditBus(item)"
                                                        disabled="@(editingBusId is not null)">
                                                    <span class="bi bi-pencil"></span> Edit
                                                </button>
                                            }
                                            @if (AuthState.HasPermission("Bus.Delete") && !item.DeleteFlag)
                                            {
                                                <button class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 hover:border-rose-400 hover:text-rose-600 text-slate-600 text-xs font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50"
                                                        @onclick="() => DeleteBus(item.BusId)"
                                                        disabled="@(editingBusId is not null)">
                                                    <span class="bi bi-trash"></span> Delete
                                                </button>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="px-6 py-4 text-slate-400">@(startNo + itemIndex + 1)</td>
                                <td class="px-6 py-4 font-medium text-slate-900">
                                    <div class="flex items-center gap-2">
                                        <span class="bi bi-bus-front text-slate-400"></span> @item.BusNo
                                        @if (item.DeleteFlag)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-rose-50 text-rose-700 border border-rose-200">Deleted</span>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-slate-500">
                                    <div class="inline-flex items-center px-2.5 py-0.5 rounded-md border border-slate-200 bg-slate-50 text-slate-700 font-mono text-xs">
                                        @item.BusLicense
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    @if (!string.IsNullOrEmpty(item.CreatedByName))
                                    {
                                        <span class="text-slate-700 font-medium">@item.CreatedByName</span>
                                        @if (!string.IsNullOrEmpty(item.CreatedByRole))
                                        {
                                            <span class="text-slate-400 text-xs ml-1">(@item.CreatedByRole)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-slate-300">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (response.Data is not null)
        {
            <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="text-sm text-slate-500">
                    Total: <strong class="text-slate-900 font-semibold">@response.Data.TotalCount</strong> buses
                </div>
                <div class="flex items-center gap-2">
                    <button class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" @onclick="() => ChangePage(request.PageNo - 1)" disabled="@(request.PageNo <= 1)">
                        Previous
                    </button>
                    <span class="text-sm text-slate-600 font-medium px-2">Page @request.PageNo of @TotalPages</span>
                    <button class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" @onclick="() => ChangePage(request.PageNo + 1)" disabled="@(request.PageNo >= TotalPages)">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
}
else if (response.Message is not null)
{
    <div class="mb-6 p-4 rounded-xl bg-rose-50 text-rose-700 text-sm border border-rose-200 flex items-center gap-2">
        <span class="bi bi-exclamation-triangle"></span> @response.Message
    </div>
}
