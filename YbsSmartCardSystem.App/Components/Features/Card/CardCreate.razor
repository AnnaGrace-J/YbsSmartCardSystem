@page "/card/new"
@inject ApiService ApiService
@inject NavigationManager NavigationManager

<PageHeader Title="Register New Card" Subtitle="Issue a new smart card to a passenger" />

<div class="max-w-2xl mt-6">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <!-- Progress Bar -->
        <div class="bg-slate-50 border-b border-slate-200 px-8 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 @(currentStep >= 1 ? "text-blue-600" : "text-slate-400")">
                    <span class="w-6 h-6 rounded-full @(currentStep >= 1 ? "bg-blue-100" : "bg-slate-100") flex items-center justify-center text-xs font-bold">1</span>
                    <span class="text-sm font-medium">Verify Phone</span>
                </div>
                <div class="flex-1 h-px bg-slate-200 mx-4"></div>
                <div class="flex items-center gap-2 @(currentStep >= 2 ? "text-blue-600" : "text-slate-400")">
                    <span class="w-6 h-6 rounded-full @(currentStep >= 2 ? "bg-blue-100" : "bg-slate-100") flex items-center justify-center text-xs font-bold">2</span>
                    <span class="text-sm font-medium">OTP</span>
                </div>
                <div class="flex-1 h-px bg-slate-200 mx-4"></div>
                <div class="flex items-center gap-2 @(currentStep >= 3 ? "text-blue-600" : "text-slate-400")">
                    <span class="w-6 h-6 rounded-full @(currentStep >= 3 ? "bg-blue-100" : "bg-slate-100") flex items-center justify-center text-xs font-bold">3</span>
                    <span class="text-sm font-medium">Details</span>
                </div>
            </div>
        </div>

        <div class="p-8">
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="mb-6 p-4 rounded-xl @(isSuccess ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-rose-50 text-rose-700 border-rose-200") border flex items-start gap-3">
                    <span class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") mt-0.5"></span>
                    <span class="text-sm font-medium">@message</span>
                </div>
            }

            @if (currentStep == 1)
            {
                <div class="mb-6 text-center">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-50 text-blue-600 mb-4">
                        <span class="bi bi-telephone text-3xl"></span>
                    </div>
                    <h2 class="text-xl font-bold text-slate-900">Phone Verification</h2>
                    <p class="text-slate-500 text-sm mt-1">Enter the passenger's mobile number</p>
                </div>

                <div class="space-y-5">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Mobile No <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                                <span class="bi bi-phone"></span>
                            </span>
                            <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm" 
                                   type="text" @bind="phoneNumber" placeholder="e.g. 09123456789" />
                        </div>
                    </div>
                    
                    <div class="flex gap-3 pt-4">
                        <button class="flex-1 py-3 btn-primary font-semibold rounded-xl shadow-sm" @onclick="SendOtp" disabled="@isProcessing">
                            @(isProcessing ? "Sending OTP..." : "Send OTP")
                        </button>
                        <NavLink class="px-6 py-3 btn-secondary font-medium rounded-xl shadow-sm text-center" href="/cards">Cancel</NavLink>
                    </div>
                </div>
            }
            else if (currentStep == 2)
            {
                <div class="mb-6 text-center">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-50 text-blue-600 mb-4">
                        <span class="bi bi-shield-lock text-3xl"></span>
                    </div>
                    <h2 class="text-xl font-bold text-slate-900">Enter OTP</h2>
                    <p class="text-slate-500 text-sm mt-1">Code sent to @phoneNumber</p>
                </div>

                <div class="space-y-5">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">OTP Code <span class="text-rose-500">*</span></label>
                        <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-xl px-4 py-3 text-center tracking-[0.5em] font-mono text-xl focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200" 
                               type="text" @bind="otpCode" placeholder="000000" maxlength="6" />
                    </div>
                    
                    <div class="flex gap-3 pt-4">
                        <button class="flex-1 py-3 btn-primary font-semibold rounded-xl shadow-sm" @onclick="VerifyOtp" disabled="@isProcessing">
                            @(isProcessing ? "Verifying..." : "Verify OTP")
                        </button>
                        <button class="px-6 py-3 btn-secondary font-medium rounded-xl shadow-sm" @onclick="() => currentStep = 1">Back</button>
                    </div>
                </div>
            }
            else if (currentStep == 3)
            {
                <div class="mb-6 text-center">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-50 text-blue-600 mb-4">
                        <span class="bi bi-person-vcard text-3xl"></span>
                    </div>
                    <h2 class="text-xl font-bold text-slate-900">Card Details</h2>
                    <p class="text-slate-500 text-sm mt-1">Provide passenger information</p>
                </div>

                <div class="space-y-5">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Mobile No</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                                <span class="bi bi-phone"></span>
                            </span>
                            <input class="w-full bg-slate-50 border border-slate-200 text-slate-500 rounded-xl pl-10 pr-4 py-3 text-sm cursor-not-allowed" 
                                   type="text" value="@phoneNumber" readonly />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Owner Name <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                                <span class="bi bi-person"></span>
                            </span>
                            <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm" 
                                   type="text" @bind="ownerName" placeholder="e.g. U Hlaing" />
                        </div>
                    </div>
                    
                    <div class="pt-4">
                        <button class="w-full py-3 btn-primary font-semibold rounded-xl shadow-sm" @onclick="CreateCard" disabled="@isProcessing">
                            @(isProcessing ? "Creating Card..." : "Complete Registration")
                        </button>
                    </div>
                </div>
            }
            else if (currentStep == 4)
            {
                <div class="text-center py-8">
                    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-emerald-100 text-emerald-600 mb-6">
                        <span class="bi bi-check-lg text-4xl"></span>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-2">Registration Complete!</h2>
                    <p class="text-slate-500 mb-8">The card has been successfully registered.</p>
                    
                    <div class="bg-gradient-to-br from-slate-900 to-slate-800 p-6 rounded-2xl inline-block text-left mb-8 shadow-lg max-w-sm w-full mx-auto border border-slate-700">
                        <p class="text-slate-400 text-xs uppercase tracking-wider font-semibold mb-1">Generated Card No</p>
                        <p class="text-emerald-400 font-mono text-2xl tracking-wider">@generatedCardNumber</p>
                    </div>
                    
                    <div>
                        <NavLink class="inline-flex px-8 py-3 btn-primary font-semibold rounded-xl shadow-sm" href="/cards">Back to Card List</NavLink>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private int currentStep = 1;
    private string phoneNumber = "";
    private string otpCode = "";
    private string ownerName = "";
    private string generatedCardNumber = "";
    
    private string? message;
    private bool isSuccess;
    private bool isProcessing;

    private async Task SendOtp()
    {
        if (string.IsNullOrWhiteSpace(phoneNumber))
        {
            message = "Phone number is required.";
            isSuccess = false;
            return;
        }

        isProcessing = true;
        message = null;

        var request = new CardRegistrationSendOtpRequestModel { PhoneNumber = phoneNumber };
        var response = await ApiService.SendCardRegistrationOtp(request);

        if (response.IsSuccess)
        {
            isSuccess = true;
            message = "OTP sent successfully. Please check your phone.";
            currentStep = 2;
        }
        else
        {
            isSuccess = false;
            message = response.Message;
        }

        isProcessing = false;
    }

    private async Task VerifyOtp()
    {
        if (string.IsNullOrWhiteSpace(otpCode))
        {
            message = "OTP code is required.";
            isSuccess = false;
            return;
        }

        isProcessing = true;
        message = null;

        var request = new CardRegistrationVerifyOtpRequestModel { PhoneNumber = phoneNumber, OtpCode = otpCode };
        var response = await ApiService.VerifyCardRegistrationOtp(request);

        if (response.IsSuccess)
        {
            isSuccess = true;
            message = "OTP verified successfully. You can now create the card.";
            currentStep = 3;
        }
        else
        {
            isSuccess = false;
            message = response.Message;
        }

        isProcessing = false;
    }

    private async Task CreateCard()
    {
        if (string.IsNullOrWhiteSpace(ownerName))
        {
            message = "Owner name is required.";
            isSuccess = false;
            return;
        }

        isProcessing = true;
        message = null;

        var request = new CardCreateRequestModel { OwnerName = ownerName, MobileNo = phoneNumber };
        var response = await ApiService.CardCreate(request);

        if (response.IsSuccess)
        {
            isSuccess = true;
            message = response.Message;
            generatedCardNumber = response.Data!.CardNum;
            currentStep = 4;
        }
        else
        {
            isSuccess = false;
            message = response.Message;
        }

        isProcessing = false;
    }
}
