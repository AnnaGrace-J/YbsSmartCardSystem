@page "/cards"
@inject ApiService ApiService
@inject YbsSmartCardSystem.App.Services.AuthStateService AuthState

<PageHeader Title="Card Registry" Subtitle="Manage passenger cards and balances">
    @if (AuthState.HasPermission("Card.Register"))
    {
        <NavLink class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm" href="/card/new">
            <span class="bi bi-plus-lg"></span> New Card
        </NavLink>
    }
</PageHeader>

<div class="mb-6 flex flex-col md:flex-row gap-3">
    <div class="relative flex-1 max-w-md">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
            <span class="bi bi-search"></span>
        </span>
        <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg pl-10 pr-4 py-2.5 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm shadow-sm" 
               placeholder="Search by Card No or Owner Name..." @bind="searchText" @onkeyup="@(e => e.Key == "Enter" ? Search() : Task.CompletedTask)" />
    </div>
    <div class="relative w-full sm:w-48">
        <select class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm shadow-sm"
                @bind="StatusFilter" @bind:after="Search">
            <option value="active">Active Cards</option>
            <option value="inactive">Inactive Cards</option>
            <option value="all">All Cards</option>
        </select>
    </div>
    <div class="relative w-full sm:w-48">
        <input type="date" class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm shadow-sm" 
               @bind="request.FilterDate" @bind:after="Search" />
    </div>
    <button class="inline-flex items-center justify-center px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded-lg transition-colors border border-slate-200 shadow-sm" @onclick="Search">
        Search
    </button>
</div>

@if (editingCardId is not null)
{
    <div class="bg-slate-50 rounded-lg p-6 mb-6 border border-slate-200 shadow-sm">
        <h5 class="text-lg font-semibold text-slate-900 mb-4">Edit Card</h5>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="mb-4 p-3 rounded-lg bg-rose-50 text-rose-700 text-sm border border-rose-200 flex items-center gap-2">
                <span class="bi bi-exclamation-triangle"></span> @message
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Card Number</label>
                <div class="w-full bg-slate-100 border border-slate-200 text-slate-500 rounded-lg px-3 py-2 text-sm font-mono cursor-not-allowed">
                    @editingCardNum
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Owner Name</label>
                <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" type="text" @bind="editCard.OwnerName" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Mobile No</label>
                <div class="w-full bg-slate-100 border border-slate-200 text-slate-500 rounded-lg px-3 py-2 text-sm font-mono cursor-not-allowed">
                    @(string.IsNullOrEmpty(editingMobileNo) ? "-" : editingMobileNo)
                </div>
            </div>
        </div>

        <div class="flex gap-3">
            <button class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" @onclick="UpdateCard" disabled="@isSaving">
                @(isSaving ? "Saving…" : "Update")
            </button>
            <button class="inline-flex items-center px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg border border-slate-200 transition-colors shadow-sm disabled:opacity-50" @onclick="CancelEdit" disabled="@isSaving">
                Cancel
            </button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(message) && editingCardId is null)
{
    <div class="mb-6 p-4 rounded-lg bg-blue-50 text-blue-700 text-sm border border-blue-200 flex items-center gap-2">
        <span class="bi bi-info-circle"></span> @message
    </div>
}

@if (response.IsSuccess)
{
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold tracking-wider">
                    <tr>
                        <th class="px-6 py-4">NO</th>
                        <th class="px-6 py-4">TOP UP</th>
                        <th class="px-6 py-4">CARD NO</th>
                        <th class="px-6 py-4">FULLNAME</th>
                        <th class="px-6 py-4">MOBILENO</th>
                        <th class="px-6 py-4 text-right">BALANCE</th>
                        <th class="px-6 py-4">CREATED BY</th>
                        <th class="px-6 py-4">ACTIONS</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (response.Data is not null)
                    {
                        int rowNo = (request.PageNo - 1) * request.PageSize;
                        @foreach (var item in response.Data.Cards)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors @(editingCardId == item.CardId ? "bg-amber-50" : "")">
                                <td class="px-6 py-4 text-slate-400 whitespace-nowrap">@(++rowNo)</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <NavLink class="inline-flex items-center justify-center gap-1.5 h-8 px-3 bg-[#f0f4ff] hover:bg-[#e1e9ff] text-[#0052cc] text-xs font-semibold rounded-md border border-[#d2e0ff] transition-all duration-200 active:scale-95 shadow-sm"
                                             href="@($"/topup/new?cardId={item.CardId}")">
                                        <span class="bi bi-plus-circle text-sm"></span>
                                        Top Up
                                    </NavLink>
                                </td>
                                <td class="px-6 py-4 font-mono text-slate-900 whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        @item.CardNum
                                        <button class="inline-flex items-center justify-center h-6 w-6 rounded border transition-all duration-200 active:scale-95 shadow-sm @(copiedItem == $"card-{item.CardId}" ? "bg-emerald-50 border-emerald-200 text-emerald-600" : "bg-blue-50 border-blue-200 text-blue-600 hover:bg-blue-50/50 hover:border-blue-300")"
                                                @onclick="@(() => CopyText($"card-{item.CardId}", item.CardNum))"
                                                title="Copy card number">
                                            <span class="bi @(copiedItem == $"card-{item.CardId}" ? "bi-check" : "bi-copy") text-[10px]"></span>
                                        </button>
                                        @if (item.DeleteFlag)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-rose-50 text-rose-700 border border-rose-200">Deleted</span>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4 font-bold text-slate-900 whitespace-nowrap">@item.OwnerName</td>
                                <td class="px-6 py-4 font-mono text-slate-500 whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        @item.MobileNo
                                        <button class="inline-flex items-center justify-center h-6 w-6 rounded border transition-all duration-200 active:scale-95 shadow-sm @(copiedItem == $"mobile-{item.CardId}" ? "bg-emerald-50 border-emerald-200 text-emerald-600" : "bg-blue-50 border-blue-200 text-blue-600 hover:bg-blue-50/50 hover:border-blue-300")"
                                                @onclick="@(() => CopyText($"mobile-{item.CardId}", item.MobileNo ?? ""))"
                                                title="Copy mobile number">
                                            <span class="bi @(copiedItem == $"mobile-{item.CardId}" ? "bi-check" : "bi-copy") text-[10px]"></span>
                                        </button>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <span class="font-bold text-slate-900">@item.Balance.ToString("N0")</span>
                                    <span class="text-slate-400 text-xs ml-1">MMK</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (!string.IsNullOrEmpty(item.CreatedByName))
                                    {
                                        <span class="text-slate-700 font-medium">@item.CreatedByName</span>
                                        @if (!string.IsNullOrEmpty(item.CreatedByRole))
                                        {
                                            <span class="text-slate-400 text-xs ml-1">(@item.CreatedByRole)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-slate-300">—</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        <button class="inline-flex items-center justify-center gap-1.5 h-8 px-3 bg-white hover:bg-slate-100 text-slate-700 text-xs font-medium rounded-md border border-slate-200 hover:border-amber-400 hover:text-amber-600 transition-all duration-200 active:scale-95 shadow-sm disabled:opacity-50"
                                                @onclick="() => EditCard(item)"
                                                disabled="@(editingCardId is not null)">
                                            <span class="bi bi-pencil text-sm text-amber-600"></span>
                                            Edit
                                        </button>
                                        @if (AuthState.HasPermission("Card.Delete") && !item.DeleteFlag)
                                        {
                                            <button class="inline-flex items-center justify-center gap-1.5 h-8 px-3 bg-white hover:bg-red-100 text-slate-700 text-xs font-medium rounded-md border border-slate-200 hover:border-rose-400 hover:text-rose-600 transition-all duration-200 active:scale-95 shadow-sm disabled:opacity-50"
                                                    @onclick="() => DeleteCard(item.CardId)"
                                                    disabled="@(editingCardId is not null)">
                                                <span class="bi bi-trash text-sm text-rose-500"></span>
                                                Delete
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (response.Data is not null)
        {
            <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="text-sm text-slate-500">
                    Total: <strong class="text-slate-900">@response.Data.TotalCount</strong> cards &middot; 10 per page
                </div>
                <div class="flex items-center gap-2">
                    <button class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-md transition-colors shadow-sm disabled:opacity-50" @onclick="() => ChangePage(request.PageNo - 1)" disabled="@(request.PageNo <= 1)">
                        Previous
                    </button>
                    <span class="text-sm text-slate-600 px-2">Page <strong class="text-slate-900">@request.PageNo</strong> of @TotalPages</span>
                    <button class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-md transition-colors shadow-sm disabled:opacity-50" @onclick="() => ChangePage(request.PageNo + 1)" disabled="@(request.PageNo >= TotalPages)">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
}
else if (response.Message is not null)
{
    <div class="mb-6 p-4 rounded-xl bg-rose-50 text-rose-700 text-sm border border-rose-200 flex items-center gap-2">
        <span class="bi bi-exclamation-triangle"></span> @response.Message
    </div>
}

