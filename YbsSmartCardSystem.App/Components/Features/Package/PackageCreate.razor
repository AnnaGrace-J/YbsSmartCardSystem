@page "/packages/create"
@using YbsSmartCardSystem.Contracts.Features.Package
@using YbsSmartCardSystem.App.Services
@inject ApiService Api
@inject NavigationManager NavManager

<PageTitle>Create Package</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create Package</h4>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger">@ErrorMessage</div>
                    }

                    <EditForm Model="@Model" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label class="form-label">Package Code</label>
                            <InputText class="form-control" @bind-Value="Model.PackageCode" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Package Name</label>
                            <InputText class="form-control" @bind-Value="Model.PackageName" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Price</label>
                            <InputNumber class="form-control" @bind-Value="Model.Price" />
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Ride Limit (Optional)</label>
                                <InputNumber class="form-control" @bind-Value="Model.RideLimit" />
                                <div class="form-text">Leave blank for unlimited rides.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Valid Days (Optional)</label>
                                <InputNumber class="form-control" @bind-Value="Model.ValidDays" />
                                <div class="form-text">Leave blank for no expiration.</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" @bind-Value="Model.Description" rows="3" />
                        </div>

                        <div class="mb-4 form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="Model.IsActive" id="isActiveCheck" />
                            <label class="form-check-label" for="isActiveCheck">
                                Is Active
                            </label>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/packages" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">
                                @if (IsSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span>Create</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>
