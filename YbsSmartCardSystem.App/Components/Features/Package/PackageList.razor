@page "/packages"
@using YbsSmartCardSystem.Contracts.Features.Package
@using YbsSmartCardSystem.App.Services
@inject ApiService Api
@inject NavigationManager NavManager

<PageTitle>Package Management</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Packages</h2>
        <a href="/packages/create" class="btn btn-primary">Create New Package</a>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <input type="text" class="form-control" placeholder="Search by Code or Name..." @bind="Request.Search" />
                </div>
                <div class="col-md-4">
                    <select class="form-select" @bind="Request.IsActive">
                        <option value="">All Statuses</option>
                        <option value="true">Active Only</option>
                        <option value="false">Inactive Only</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-secondary w-100" @onclick="SearchPackages">Search</button>
                </div>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (Packages != null && Packages.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Ride Limit</th>
                        <th>Valid Days</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pkg in Packages)
                    {
                        <tr>
                            <td>@pkg.PackageId</td>
                            <td>@pkg.PackageCode</td>
                            <td>@pkg.PackageName</td>
                            <td>@pkg.Price.ToString("C")</td>
                            <td>@(pkg.RideLimit?.ToString() ?? "Unlimited")</td>
                            <td>@(pkg.ValidDays?.ToString() ?? "Unlimited")</td>
                            <td>
                                @if (pkg.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePackage(pkg.PackageId)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div>
                Showing @((Request.PageNo - 1) * Request.PageSize + 1) to @Math.Min(Request.PageNo * Request.PageSize, TotalCount) of @TotalCount entries
            </div>
            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item @(Request.PageNo <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(Request.PageNo - 1)">Previous</button>
                    </li>
                    <li class="page-item @(Request.PageNo * Request.PageSize >= TotalCount ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(Request.PageNo + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        </div>
    }
    else
    {
        <div class="alert alert-info">No packages found.</div>
    }
</div>
