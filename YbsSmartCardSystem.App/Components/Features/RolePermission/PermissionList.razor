@page "/permissions"
@using YbsSmartCardSystem.Contracts.Features.RolePermission
@inject YbsSmartCardSystem.App.Services.ApiService Api

<PageHeader Title="System Permissions" Subtitle="View all available permissions in the system" />

<div class="mb-6 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row gap-3">
    <div class="relative flex-1">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
            <span class="bi bi-search"></span>
        </span>
        <input type="text" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-2.5 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm" placeholder="Search by code or name..." @bind="Request.Search" @bind:event="oninput" @onkeyup="HandleSearch" />
    </div>
    <div class="relative flex-1">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
            <span class="bi bi-funnel"></span>
        </span>
        <input type="text" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-2.5 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm" placeholder="Filter by feature name..." @bind="Request.FeatureName" @bind:event="oninput" @onkeyup="HandleSearch" />
    </div>
    <div class="flex items-end gap-2">
        <button class="inline-flex items-center px-4 py-2 btn-primary text-sm font-medium rounded-xl shadow-sm" @onclick="Search">
            Search
        </button>
        <button class="inline-flex items-center px-4 py-2 btn-secondary text-sm font-medium rounded-xl shadow-sm" @onclick="Clear">
            Clear
        </button>
    </div>
</div>

@if (ErrorMessage != null)
{
    <div class="mb-6 p-4 rounded-2xl bg-rose-50 text-rose-700 text-sm border border-rose-200 flex items-center gap-2">
        <span class="bi bi-exclamation-triangle"></span> @ErrorMessage
    </div>
}

@if (IsLoading)
{
    <div class="flex justify-center items-center py-12">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
    </div>
}
else if (!Permissions.Any())
{
    <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm text-center">
        <span class="bi bi-shield-lock text-4xl text-slate-300 mb-3 block"></span>
        <h3 class="text-lg font-bold text-slate-900 mb-1">No Permissions Found</h3>
        <p class="text-slate-500 text-sm">There are currently no permissions matching your criteria.</p>
    </div>
}
else
{
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold tracking-wider">
                    <tr>
                        <th class="px-6 py-4">No</th>
                        <th class="px-6 py-4">Code</th>
                        <th class="px-6 py-4">Name</th>
                        <th class="px-6 py-4">Feature</th>
                        <th class="px-6 py-4">Action</th>
                        <th class="px-6 py-4">Description</th>
                        <th class="px-6 py-4">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @{ int rowNo = (Request.PageNo - 1) * Request.PageSize; }
                    @foreach (var perm in Permissions)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4 text-slate-400 whitespace-nowrap">@(++rowNo)</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono text-xs font-semibold">
                                    <span class="bi bi-key text-[10px]"></span> @perm.PermissionCode
                                </span>
                            </td>
                            <td class="px-6 py-4 font-semibold text-slate-900 whitespace-nowrap">@perm.PermissionName</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                                    <span class="bi bi-box text-[10px]"></span> @perm.FeatureName
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
                                    <span class="bi bi-lightning text-[10px]"></span> @perm.ActionName
                                </span>
                            </td>
                            <td class="px-6 py-4 text-slate-500 max-w-md truncate" title="@perm.Description">@perm.Description</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (perm.IsActive)
                                {
                                    <StatusBadge Type="success" Text="Active" IconClass="bi bi-check-circle" />
                                }
                                else
                                {
                                    <StatusBadge Type="neutral" Text="Inactive" IconClass="bi bi-dash-circle" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="text-sm text-slate-500">
                Total: <strong class="text-slate-900">@TotalCount</strong> permissions &middot; 10 per page
            </div>
            <div class="flex items-center gap-2">
                <button class="inline-flex items-center px-3 py-1.5 btn-secondary text-sm font-medium rounded-lg shadow-sm" disabled="@(Request.PageNo == 1)" @onclick="PrevPage">
                    Previous
                </button>
                <span class="text-sm text-slate-600 font-medium px-2">Page @Request.PageNo of @MaxPage</span>
                <button class="inline-flex items-center px-3 py-1.5 btn-secondary text-sm font-medium rounded-lg shadow-sm" disabled="@(Request.PageNo >= MaxPage)" @onclick="NextPage">
                    Next
                </button>
            </div>
        </div>
    </div>
}
