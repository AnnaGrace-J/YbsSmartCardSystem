@page "/roles/create"
@page "/roles/edit/{RoleId:int}"
@using YbsSmartCardSystem.Contracts.Features.RolePermission
@inject YbsSmartCardSystem.App.Services.ApiService Api
@inject NavigationManager NavManager

<PageHeader Title="@(IsEditMode ? $"Edit Role: {Model.RoleCode}" : "Create Role")" Subtitle="@(IsEditMode ? "Modify existing role details" : "Add a new system role")" />

<div class="max-w-2xl mt-6">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 md:p-8">
            @if (ErrorMessage != null)
            {
                <div class="mb-6 p-4 rounded-xl bg-rose-50 text-rose-700 text-sm border border-rose-200 flex items-center gap-2">
                    <span class="bi bi-exclamation-triangle"></span> @ErrorMessage
                </div>
            }

            <EditForm Model="@Model" OnValidSubmit="HandleSubmit" FormName="RoleCreateForm" class="space-y-5">
                <AntiforgeryToken />
                
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Role Code <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <span class="bi bi-hash"></span>
                        </span>
                        <InputText class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm font-mono disabled:opacity-70 disabled:cursor-not-allowed" @bind-Value="Model.RoleCode" disabled="@IsEditMode" placeholder="e.g. CARD_MANAGER" />
                    </div>
                    <p class="mt-2 text-xs text-slate-500">Unique code identifier for the role. Cannot be edited once created.</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Role Name <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <span class="bi bi-card-text"></span>
                        </span>
                        <InputText class="w-full bg-white border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm" @bind-Value="Model.RoleName" placeholder="Enter human-readable role name" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Description</label>
                    <InputTextArea class="w-full bg-white border border-slate-200 text-slate-900 rounded-xl p-4 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm resize-none" @bind-Value="Model.Description" rows="3" placeholder="Describe the purpose and responsibilities of this role..." />
                </div>

                <div class="flex items-center gap-2 pt-2 pb-2">
                    <InputCheckbox class="w-4 h-4 text-blue-600 bg-white border-slate-300 rounded focus:ring-blue-500 focus:ring-2" id="isActiveCheck" @bind-Value="Model.IsActive" />
                    <label class="text-sm font-medium text-slate-700" for="isActiveCheck">Role is Active</label>
                </div>

                <div class="flex gap-3 pt-4 border-t border-slate-100">
                    <button type="submit" class="flex-1 py-3 btn-primary font-semibold rounded-xl shadow-sm" disabled="@IsSubmitting">
                        @(IsSubmitting ? "Saving..." : "Save Role")
                    </button>
                    <a href="/roles" class="px-6 py-3 btn-secondary font-medium rounded-xl shadow-sm text-center">
                        Cancel
                    </a>
                </div>
            </EditForm>
        </div>
    </div>
</div>
