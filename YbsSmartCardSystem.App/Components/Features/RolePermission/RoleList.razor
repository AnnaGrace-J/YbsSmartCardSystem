@page "/roles"
@using YbsSmartCardSystem.Contracts.Features.RolePermission
@inject YbsSmartCardSystem.App.Services.ApiService Api
@inject NavigationManager NavManager

<PageHeader Title="Role Management" Subtitle="Manage system roles and permissions">
    <NavLink class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-xl transition-colors shadow-sm" href="/roles/create">
        <span class="bi bi-plus-lg"></span> Create Role
    </NavLink>
</PageHeader>

<div class="mb-6 bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col sm:flex-row gap-3">
    <div class="relative flex-1">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
            <span class="bi bi-search"></span>
        </span>
        <input type="text" class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-2.5 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm" placeholder="Search by code or name..." @bind="Request.Search" @bind:event="oninput" @onkeyup="HandleSearch" />
    </div>
    <div class="relative w-full sm:w-48">
        <select class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-xl px-4 py-2.5 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm appearance-none" @bind="IsActiveFilter" @bind:after="LoadRoles">
            <option value="">All Statuses</option>
            <option value="true">Active Only</option>
            <option value="false">Inactive Only</option>
        </select>
        <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
            <span class="bi bi-chevron-down"></span>
        </div>
    </div>
</div>

@if (ErrorMessage != null)
{
    <div class="mb-6 p-4 rounded-xl bg-rose-50 text-rose-700 text-sm border border-rose-200 flex items-center gap-2">
        <span class="bi bi-exclamation-triangle"></span> @ErrorMessage
    </div>
}

@if (IsLoading)
{
    <div class="flex justify-center items-center py-12">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
    </div>
}
else if (!Roles.Any())
{
    <div class="bg-slate-50 p-8 rounded-2xl border border-slate-200 text-center">
        <span class="bi bi-shield-lock text-4xl text-slate-300 mb-3 block"></span>
        <h3 class="text-lg font-medium text-slate-900 mb-1">No Roles Found</h3>
        <p class="text-slate-500 text-sm">There are currently no roles matching your criteria.</p>
    </div>
}
else
{
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold tracking-wider">
                    <tr>
                        <th class="px-6 py-4">Code</th>
                        <th class="px-6 py-4">Name</th>
                        <th class="px-6 py-4">Description</th>
                        <th class="px-6 py-4">System Role</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var role in Roles)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4 font-mono text-slate-900">@role.RoleCode</td>
                            <td class="px-6 py-4 font-medium text-slate-900">@role.RoleName</td>
                            <td class="px-6 py-4 text-slate-500">@role.Description</td>
                            <td class="px-6 py-4">
                                @if (role.IsSystemRole)
                                {
                                    <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-200">System</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">User-Defined</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (role.IsActive)
                                {
                                    <StatusBadge Type="success" Text="Active" />
                                }
                                else
                                {
                                    <StatusBadge Type="neutral" Text="Inactive" />
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="/roles/permissions/@role.RoleId" class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:border-blue-400 hover:text-blue-600 text-slate-600 text-xs font-medium rounded-lg transition-colors shadow-sm" title="Permissions">
                                        <span class="bi bi-shield-lock me-1"></span> Perms
                                    </a>
                                    @if (!role.IsSystemRole)
                                    {
                                        <a href="/roles/edit/@role.RoleId" class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:border-amber-400 hover:text-amber-600 text-slate-600 text-xs font-medium rounded-lg transition-colors shadow-sm" title="Edit">
                                            <span class="bi bi-pencil"></span>
                                        </a>
                                        <button class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:border-rose-400 hover:text-rose-600 text-slate-600 text-xs font-medium rounded-lg transition-colors shadow-sm" @onclick="() => ConfirmDelete(role)" title="Delete">
                                            <span class="bi bi-trash"></span>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="text-sm text-slate-500">
                Showing <strong class="text-slate-900">@(((Request.PageNo - 1) * Request.PageSize) + 1)</strong> to <strong class="text-slate-900">@(Math.Min(Request.PageNo * Request.PageSize, TotalCount))</strong> of <strong class="text-slate-900">@TotalCount</strong> entries
            </div>
            <div class="flex items-center gap-2">
                <button class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" disabled="@(Request.PageNo == 1)" @onclick="PrevPage">
                    Previous
                </button>
                <span class="text-sm text-slate-600 font-medium px-2">Page @Request.PageNo of @MaxPage</span>
                <button class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" disabled="@(Request.PageNo >= MaxPage)" @onclick="NextPage">
                    Next
                </button>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm && RoleToDelete != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden max-w-md w-full">
            <div class="p-6">
                <div class="flex items-center gap-3 mb-4 text-rose-600">
                    <span class="bi bi-exclamation-triangle text-2xl"></span>
                    <h3 class="text-lg font-bold text-slate-900">Delete Role?</h3>
                </div>
                <p class="text-slate-600 text-sm mb-2">Are you sure you want to delete the role <strong class="text-slate-900">@RoleToDelete.RoleCode</strong> (@RoleToDelete.RoleName)?</p>
                <p class="text-rose-500 text-xs font-medium">This will also deactivate this role's user and permission assignments.</p>
            </div>
            <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 flex justify-end gap-3">
                <button class="px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg border border-slate-200 transition-colors shadow-sm" @onclick="CancelDelete">Cancel</button>
                <button class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm" @onclick="DeleteRole">Delete</button>
            </div>
        </div>
    </div>
}
