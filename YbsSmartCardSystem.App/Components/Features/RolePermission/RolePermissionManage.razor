@page "/roles/permissions/{RoleId:int}"
@using YbsSmartCardSystem.Contracts.Features.RolePermission
@inject YbsSmartCardSystem.App.Services.ApiService Api
@inject NavigationManager NavManager

<h3>Manage Role Permissions: @RoleCode</h3>

@if (ErrorMessage != null)
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

@if (IsLoading)
{
    <p>Loading permissions...</p>
}
else
{
    <div class="row">
        @foreach (var group in GroupedPermissions)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0 text-capitalize">@group.Key</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var permission in group.Value)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="perm-@permission.PermissionId"
                                       checked="@SelectedPermissionIds.Contains(permission.PermissionId)"
                                       @onchange="(e) => TogglePermission(permission.PermissionId, e.Value)" />
                                <label class="form-check-label" for="perm-@permission.PermissionId">
                                    <strong>@permission.PermissionName</strong> <br />
                                    <small class="text-muted">@permission.PermissionCode - @permission.Description</small>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-primary" @onclick="HandleSave" disabled="@IsSaving">
            @(IsSaving ? "Saving..." : "Save Changes")
        </button>
        <a href="/roles" class="btn btn-secondary">Back to Roles</a>
    </div>
}
