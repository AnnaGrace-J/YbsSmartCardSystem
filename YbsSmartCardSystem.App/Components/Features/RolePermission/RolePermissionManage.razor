@page "/roles/permissions/{RoleId:int}"
@using YbsSmartCardSystem.Contracts.Features.RolePermission
@inject YbsSmartCardSystem.App.Services.ApiService Api
@inject NavigationManager NavManager

<PageHeader Title="Role Permissions" Subtitle="@($"Manage access permissions for role: {RoleCode}")" />

@if (ErrorMessage != null)
{
    <div class="mb-6 mt-6 p-4 rounded-xl bg-rose-50 text-rose-700 text-sm border border-rose-200 flex items-center gap-2">
        <span class="bi bi-exclamation-triangle"></span> @ErrorMessage
    </div>
}

@if (IsLoading)
{
    <div class="flex justify-center items-center py-12 mt-6">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
        @foreach (var group in GroupedPermissions)
        {
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
                <div class="bg-slate-50 px-5 py-3 border-b border-slate-200">
                    <h5 class="mb-0 text-sm font-semibold text-slate-800 uppercase tracking-wider">@group.Key</h5>
                </div>
                <div class="p-5 flex-1 space-y-3">
                    @foreach (var permission in group.Value)
                    {
                        <div class="flex items-start gap-3 p-3 rounded-lg hover:bg-slate-50 transition-colors border border-transparent hover:border-slate-100">
                            <div class="pt-0.5">
                                <input class="w-4 h-4 text-blue-600 bg-white border-slate-300 rounded focus:ring-blue-500 focus:ring-2 mt-0.5" type="checkbox" id="perm-@permission.PermissionId"
                                       checked="@SelectedPermissionIds.Contains(permission.PermissionId)"
                                       @onchange="(e) => TogglePermission(permission.PermissionId, e.Value)" />
                            </div>
                            <label class="flex-1 cursor-pointer" for="perm-@permission.PermissionId">
                                <span class="block text-sm font-medium text-slate-900 mb-0.5">@permission.PermissionName</span>
                                <span class="block text-xs text-slate-500 font-mono mb-1">@permission.PermissionCode</span>
                                <span class="block text-xs text-slate-500">@permission.Description</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="flex gap-3 mt-8 pt-6 border-t border-slate-200">
        <button class="inline-flex items-center px-6 py-2.5 btn-primary text-sm font-medium rounded-xl shadow-sm" @onclick="HandleSave" disabled="@IsSaving">
            @(IsSaving ? "Saving..." : "Save Changes")
        </button>
        <a href="/roles" class="inline-flex items-center px-6 py-2.5 btn-secondary text-sm font-medium rounded-xl shadow-sm">
            Back to Roles
        </a>
    </div>
}
