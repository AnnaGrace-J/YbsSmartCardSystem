@page "/users/{UserId:int}/roles"
@using YbsSmartCardSystem.Contracts.Features.RolePermission
@inject YbsSmartCardSystem.App.Services.ApiService Api
@inject NavigationManager NavManager

<h3>Manage Roles for User: @UserName</h3>

@if (ErrorMessage != null)
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

@if (IsLoading)
{
    <p>Loading roles...</p>
}
else
{
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Available Roles</h5>
        </div>
        <div class="card-body">
            @if (!AvailableRoles.Any())
            {
                <p>No active roles available.</p>
            }
            else
            {
                @foreach (var role in AvailableRoles)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="role-@role.RoleId"
                               checked="@SelectedRoleIds.Contains(role.RoleId)"
                               @onchange="(e) => ToggleRole(role.RoleId, e.Value)" />
                        <label class="form-check-label" for="role-@role.RoleId">
                            <strong>@role.RoleName</strong> <br />
                            <small class="text-muted">@role.RoleCode - @role.Description</small>
                        </label>
                    </div>
                }
            }
        </div>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="HandleSave" disabled="@IsSaving">
            @(IsSaving ? "Saving..." : "Save Changes")
        </button>
        <a href="/cards" class="btn btn-secondary">Cancel</a>
    </div>
}
