@page "/terminals"
@inject YbsSmartCardSystem.App.Services.AuthStateService AuthState

<PageHeader Title="Terminal Fleet Registry" Subtitle="Manage card reader terminals">
    @if (AuthState.HasPermission("Terminal.Create"))
    {
        <NavLink class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-xl transition-colors shadow-sm" href="/terminal/new">
            <span class="bi bi-plus-lg"></span> Register Terminal
        </NavLink>
    }
</PageHeader>

<div class="mb-6 flex flex-col md:flex-row gap-3">
    <div class="relative flex-1 max-w-md">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
            <span class="bi bi-search"></span>
        </span>
        <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg pl-10 pr-4 py-2.5 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm shadow-sm" 
               placeholder="Search by Serial No, Bus No or Bus License..." @bind="searchText" @onkeyup="@(e => e.Key == "Enter" ? Search() : Task.CompletedTask)" />
    </div>
    <div class="relative w-full sm:w-48">
        <select class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm shadow-sm"
                @bind="StatusFilter" @bind:after="Search">
            <option value="active">Active Terminals</option>
            <option value="inactive">Inactive Terminals</option>
            <option value="all">All Terminals</option>
        </select>
    </div>
    <button class="inline-flex items-center justify-center px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded-lg transition-colors border border-slate-200 shadow-sm" @onclick="Search">
        Search
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6 p-4 rounded-xl @(isSuccess ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-rose-50 text-rose-700 border-rose-200") border flex items-start gap-3 relative">
        <span class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") mt-0.5"></span>
        <span class="text-sm font-medium">@message</span>
        <button type="button" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600" @onclick="() => message = null">
            <span class="bi bi-x-lg"></span>
        </button>
    </div>
}

@if (editingTerminalId is not null)
{
    <div class="bg-slate-50 rounded-xl p-6 mb-6 border border-slate-200 shadow-sm max-w-3xl">
        <h5 class="text-lg font-semibold text-slate-900 mb-4">Edit Terminal Details</h5>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Terminal Serial Number</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                        <span class="bi bi-upc-scan"></span>
                    </span>
                    <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg pl-9 pr-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" type="text" maxlength="100" @bind="editTerminal.TerminalSerialNo" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Assigned Bus</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                        <span class="bi bi-bus-front"></span>
                    </span>
                    <select class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg pl-9 pr-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 appearance-none" @bind="editTerminal.BusId">
                        <option value="0">-- Select Bus --</option>
                        @if (busOptions.Data is not null)
                        {
                            @foreach (var bus in busOptions.Data.Buses)
                            {
                                <option value="@bus.BusId">@bus.BusNo — @bus.BusLicense</option>
                            }
                        }
                    </select>
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400">
                        <span class="bi bi-chevron-down"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-6 flex items-center gap-2">
            <input class="w-4 h-4 text-blue-600 bg-white border-slate-300 rounded focus:ring-blue-500 focus:ring-2" type="checkbox" id="editIsActive" @bind="editTerminalIsActive" />
            <label class="text-sm font-medium text-slate-700" for="editIsActive">Terminal is Active</label>
        </div>

        <div class="flex gap-3">
            <button class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" @onclick="UpdateTerminal" disabled="@isSaving">
                @(isSaving ? "Saving…" : "Update")
            </button>
            <button class="inline-flex items-center px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg border border-slate-200 transition-colors shadow-sm disabled:opacity-50" @onclick="CancelEdit">
                Cancel
            </button>
        </div>
    </div>
}

@if (isLoading)
{
    <div class="flex justify-center items-center py-12">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
    </div>
}
else if (!response.IsSuccess)
{
    <div class="bg-rose-50 p-8 rounded-2xl border border-rose-200 text-center">
        <span class="bi bi-exclamation-triangle text-4xl text-rose-300 mb-3 block"></span>
        <h3 class="text-lg font-medium text-slate-900 mb-1">Error Loading Terminals</h3>
        <p class="text-slate-500 text-sm">@(string.IsNullOrWhiteSpace(response.Message) ? "Unable to load terminals. Please check your permission and API connection." : response.Message)</p>
    </div>
}
else if (response.Data is null || !response.Data.Terminals.Any())
{
    <div class="bg-slate-50 p-8 rounded-2xl border border-slate-200 text-center">
        <span class="bi bi-terminal text-4xl text-slate-300 mb-3 block"></span>
        <h3 class="text-lg font-medium text-slate-900 mb-1">No Terminals Found</h3>
        <p class="text-slate-500 text-sm">There are currently no terminals registered in the system.</p>
    </div>
}
else
{
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold tracking-wider">
                    <tr>
                        <th class="px-6 py-4 w-40">Actions</th>
                        <th class="px-6 py-4">No</th>
                        <th class="px-6 py-4">Serial Number</th>
                        <th class="px-6 py-4">Bus No</th>
                        <th class="px-6 py-4">Bus License</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Created By</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @{int rowNo = (request.PageNo - 1) * request.PageSize;}
                    @foreach (var terminal in response.Data.Terminals)
                    {
                        rowNo++;
                        var localTerminal = terminal;
                        <tr class="hover:bg-slate-50/50 transition-colors @(editingTerminalId == localTerminal.TerminalId ? "bg-amber-50" : "")">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    @if (AuthState.HasPermission("Terminal.Update"))
                                    {
                                        <button class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 hover:border-amber-400 hover:text-amber-600 text-slate-600 text-xs font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" @onclick="() => EditTerminal(localTerminal)">
                                            <span class="bi bi-pencil"></span> Edit
                                        </button>
                                    }
                                    @if (AuthState.HasPermission("Terminal.Delete") && !localTerminal.DeleteFlag)
                                    {
                                        <button class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 hover:border-rose-400 hover:text-rose-600 text-slate-600 text-xs font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" @onclick="() => DeleteTerminal(localTerminal.TerminalId)">
                                            <span class="bi bi-trash"></span> Delete
                                        </button>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 text-slate-400">@rowNo</td>
                            <td class="px-6 py-4 font-mono text-slate-900">
                                <div class="flex items-center gap-2">
                                    @terminal.TerminalSerialNo
                                    @if (terminal.DeleteFlag)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-rose-50 text-rose-700 border border-rose-200">Deleted</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 font-medium text-slate-900">
                                @if (!string.IsNullOrEmpty(terminal.BusNo))
                                {
                                    <div class="flex items-center gap-2">
                                        <span class="bi bi-bus-front text-slate-400"></span> @terminal.BusNo
                                    </div>
                                }
                                else
                                {
                                    <span class="text-slate-400 italic">Unassigned</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-slate-500">
                                @if (!string.IsNullOrEmpty(terminal.BusLicense))
                                {
                                    <div class="inline-flex items-center px-2.5 py-0.5 rounded-md border border-slate-200 bg-slate-50 text-slate-700 font-mono text-xs">
                                        @terminal.BusLicense
                                    </div>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (terminal.IsActive)
                                {
                                    <StatusBadge Type="success" Text="Active" />
                                }
                                else
                                {
                                    <StatusBadge Type="neutral" Text="Inactive" />
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (!string.IsNullOrEmpty(terminal.CreatedByName))
                                {
                                    <span class="text-slate-700 font-medium">@terminal.CreatedByName</span>
                                    @if (!string.IsNullOrEmpty(terminal.CreatedByRole))
                                    {
                                        <span class="text-slate-400 text-xs ml-1">(@terminal.CreatedByRole)</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-slate-300">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-2 w-full justify-end">
                <button class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" @onclick="PrevPage" disabled="@(request.PageNo <= 1)">
                    Previous
                </button>
                <span class="text-sm text-slate-600 font-medium px-2">Page @request.PageNo of @TotalPages</span>
                <button class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" @onclick="NextPage" disabled="@(request.PageNo >= TotalPages)">
                    Next
                </button>
            </div>
        </div>
    </div>
}
