@page "/topup/new"

<PageHeader Title="Card Top Up" Subtitle="Add funds to a passenger card" />

<div class="max-w-2xl mt-6">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 md:p-8">
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="mb-6 p-4 rounded-xl @(isSuccess ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-rose-50 text-rose-700 border-rose-200") border flex items-start gap-3">
                    <span class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") mt-0.5"></span>
                    <span class="text-sm font-medium">@message</span>
                </div>
            }

            @if (isSuccess && responseData != null)
            {
                <div class="mb-8 bg-gradient-to-br from-slate-900 to-slate-800 p-6 rounded-2xl shadow-lg border border-slate-700">
                    <div class="flex items-center gap-3 mb-6 pb-6 border-b border-white/10">
                        <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center">
                            <span class="bi bi-check-lg text-emerald-400 text-xl"></span>
                        </div>
                        <div>
                            <h3 class="text-white font-semibold">Top Up Successful</h3>
                            <p class="text-slate-400 text-xs mt-0.5">Receipt: @responseData.TopUpNo</p>
                        </div>
                    </div>
                    
                    <div class="space-y-4">
                        <div class="flex justify-between items-end">
                            <div>
                                <p class="text-slate-400 text-xs uppercase tracking-wider font-semibold mb-1">Card Details</p>
                                <p class="text-white font-mono">@responseData.CardNum</p>
                                <p class="text-slate-300 text-sm mt-1">@responseData.OwnerName</p>
                            </div>
                            <div class="text-right">
                                <p class="text-slate-400 text-xs uppercase tracking-wider font-semibold mb-1">Top Up Amount</p>
                                <p class="text-emerald-400 font-bold text-xl">+@responseData.Amount.ToString("N0") MMK</p>
                            </div>
                        </div>
                        
                        <div class="pt-4 border-t border-white/10 flex justify-between items-center">
                            <p class="text-slate-400 text-sm">New Balance</p>
                            <p class="text-white font-bold text-xl">@responseData.NewBalance.ToString("N0") <span class="text-slate-400 text-sm font-normal">MMK</span></p>
                        </div>
                        
                        <div class="pt-4 flex justify-between items-center text-xs text-slate-500">
                            <span>@responseData.TopUpDate.ToString("MMM dd, yyyy HH:mm")</span>
                            @if (!string.IsNullOrEmpty(responseData.Remark))
                            {
                                <span>Remark: @responseData.Remark</span>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="space-y-6">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Select Card <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <span class="bi bi-credit-card"></span>
                        </span>
                        <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-xl pl-10 pr-10 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm"
                               placeholder="Search and select a card..."
                               @bind="cardSearchText" @bind:event="oninput"
                               @onfocus="ShowCardDropdown"
                               @onblur="HideCardDropdown" />
                        <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
                            <span class="bi bi-chevron-down"></span>
                        </div>
                        
                        @if (isCardDropdownOpen)
                        {
                            <div class="absolute z-10 w-full mt-1 bg-white border border-slate-200 rounded-xl shadow-lg max-h-60 overflow-y-auto">
                                @if (FilteredCards.Any())
                                {
                                    @foreach (var card in FilteredCards)
                                    {
                                        <div class="px-4 py-3 hover:bg-slate-50 cursor-pointer border-b border-slate-100 last:border-0"
                                             @onmousedown="() => SelectCard(card)">
                                            <div class="text-sm font-medium text-slate-900">@card.CardNum - @card.OwnerName</div>
                                            <div class="text-xs text-slate-500 mt-0.5">Balance: <span class="font-semibold text-emerald-600">@card.Balance.ToString("N0") MMK</span></div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="px-4 py-3 text-sm text-slate-500 text-center">No cards found.</div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Top Up Amount (MMK) <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <span class="bi bi-cash"></span>
                        </span>
                        <input type="number" class="w-full bg-white border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm" 
                               placeholder="Min 1,000 - Max 100,000" @bind="request.Amount" />
                    </div>
                    <p class="text-xs text-slate-500 mt-2">Amount must be between 1,000 MMK and 100,000 MMK.</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Remark</label>
                    <textarea class="w-full bg-white border border-slate-200 text-slate-900 rounded-xl px-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm" 
                              rows="2" placeholder="Optional remark (Max 250 characters)" @bind="request.Remark"></textarea>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-slate-100">
                    <button class="flex-1 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl shadow-sm transition-all duration-200 disabled:opacity-50" @onclick="Save" disabled="@isSaving">
                        @(isSaving ? "Processing…" : "Process Top Up")
                    </button>
                    <NavLink class="px-6 py-3 bg-white hover:bg-slate-50 text-slate-700 font-medium rounded-xl border border-slate-200 shadow-sm transition-all duration-200 text-center" href="/topups">
                        History
                    </NavLink>
                    <NavLink class="px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-xl border border-slate-200 shadow-sm transition-all duration-200 text-center" href="/cards">
                        Cancel
                    </NavLink>
                </div>
            </div>
        </div>
    </div>
</div>
