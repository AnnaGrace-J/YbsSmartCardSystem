@page "/topups"

@inject YbsSmartCardSystem.App.Services.AuthStateService AuthState

<PageHeader Title="Top Up History" Subtitle="View passenger top up records">
    @if (AuthState.HasPermission("TopUp.Create"))
    {
        <NavLink class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-xl transition-colors shadow-sm" href="/topup/new">
            <span class="bi bi-plus-lg"></span> New Top Up
        </NavLink>
    }
</PageHeader>

<div class="mb-6 flex flex-col md:flex-row gap-3">

    
    <div class="relative flex-1 max-w-md">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
            <span class="bi bi-search"></span>
        </span>
        <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg pl-10 pr-4 py-2.5 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm shadow-sm" 
               placeholder="Search by Card No or Owner Name..." @bind="searchText" @onkeyup="@(e => e.Key == "Enter" ? Search() : Task.CompletedTask)" />
    </div>
    
    <div class="relative w-full sm:w-48">
        <input type="date" class="w-full bg-white border border-slate-200 text-slate-900 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm shadow-sm" 
               @bind="request.FilterDate" @bind:after="Search" />
    </div>
    
    <button class="inline-flex items-center justify-center h-10 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded-lg transition-colors border border-slate-200 shadow-sm" @onclick="Search">
        Search
    </button>
</div>

@if (response.IsSuccess)
{
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold tracking-wider">
                    <tr>
                        <th class="px-6 py-4">No</th>
                        <th class="px-6 py-4">Top Up No</th>
                        <th class="px-6 py-4">Card No</th>
                        <th class="px-6 py-4">FullName</th>
                        <th class="px-6 py-4 text-right">Amount</th>
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4">Remark</th>
                        <th class="px-6 py-4">Created By</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (response.Data is not null)
                    {
                        int rowNo = (request.PageNo - 1) * request.PageSize;
                        @foreach (var item in response.Data.TopUps)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4 text-slate-400 whitespace-nowrap">@(++rowNo)</td>
                                <td class="px-6 py-4 font-mono text-slate-900 whitespace-nowrap">@item.TopUpNo</td>
                                <td class="px-6 py-4 font-mono text-slate-900 whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        @item.CardNum
                                        <button class="inline-flex items-center justify-center h-6 w-6 rounded border transition-all duration-200 active:scale-95 shadow-sm @(copiedItem == $"topup-{item.TopUpId}" ? "bg-emerald-50 border-emerald-200 text-emerald-600" : "bg-blue-50 border-blue-200 text-blue-600 hover:bg-blue-50/50 hover:border-blue-300")"
                                                @onclick="@(() => CopyText($"topup-{item.TopUpId}", item.CardNum))"
                                                title="Copy card number">
                                            <span class="bi @(copiedItem == $"topup-{item.TopUpId}" ? "bi-check" : "bi-copy") text-[10px]"></span>
                                        </button>
                                    </div>
                                </td>
                                <td class="px-6 py-4 font-medium text-slate-900 whitespace-nowrap">@item.OwnerName</td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <span class="font-bold text-emerald-600">@item.Amount.ToString("N0")</span>
                                    <span class="text-slate-400 text-xs ml-1">MMK</span>
                                </td>
                                <td class="px-6 py-4 text-slate-500 whitespace-nowrap">@item.TopUpDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-6 py-4 text-slate-500">@item.Remark</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (!string.IsNullOrEmpty(item.CreatedByName))
                                    {
                                        <span class="text-slate-700 font-medium">@item.CreatedByName</span>
                                        @if (!string.IsNullOrEmpty(item.CreatedByRole))
                                        {
                                            <span class="text-slate-400 text-xs ml-1">(@item.CreatedByRole)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-slate-300">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (response.Data is not null)
        {
            <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="text-sm text-slate-500">
                    Total: <strong class="text-slate-900 font-semibold">@response.Data.TotalCount</strong> records &middot; 10 per page
                </div>
                <div class="flex items-center gap-2">
                    <button class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" @onclick="() => ChangePage(request.PageNo - 1)" disabled="@(request.PageNo <= 1)">
                        Previous
                    </button>
                    <span class="text-sm text-slate-600 font-medium px-2">Page @request.PageNo of @TotalPages</span>
                    <button class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg transition-colors shadow-sm disabled:opacity-50" @onclick="() => ChangePage(request.PageNo + 1)" disabled="@(request.PageNo >= TotalPages)">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
}
else if (response.Message is not null)
{
    <div class="mb-6 p-4 rounded-xl bg-rose-50 text-rose-700 text-sm border border-rose-200 flex items-center gap-2">
        <span class="bi bi-exclamation-triangle"></span> @response.Message
    </div>
}
