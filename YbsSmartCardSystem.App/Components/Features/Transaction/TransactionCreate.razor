@using YbsSmartCardSystem.Domain.Common
@page "/transactions/new"

<PageHeader Title="Bus Payment (Tap)" Subtitle="Process a card tap at a bus terminal" />

<div class="max-w-2xl mt-6">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 md:p-8">
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="mb-6 p-4 rounded-xl @(isSuccess ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-rose-50 text-rose-700 border-rose-200") border flex items-start gap-3">
                    <span class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") mt-0.5"></span>
                    <span class="text-sm font-medium">@message</span>
                </div>
            }

            @if (transactionResult is not null)
            {
                <div class="mb-8 bg-gradient-to-br from-slate-900 to-slate-800 p-6 rounded-2xl shadow-lg border border-slate-700 relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-4 opacity-10 pointer-events-none">
                        <span class="bi bi-bus-front text-9xl text-white"></span>
                    </div>

                    <div class="relative z-10 flex items-center gap-3 mb-6 pb-6 border-b border-white/10">
                        <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center">
                            <span class="bi bi-check-lg text-emerald-400 text-xl"></span>
                        </div>
                        <div>
                            <h3 class="text-white font-semibold">Payment Successful</h3>
                            <p class="text-slate-400 text-xs mt-0.5">Txn: @transactionResult.TransactionNo</p>
                        </div>
                    </div>
                    
                    <div class="relative z-10 space-y-4">
                        <div class="flex justify-between items-end">
                            <div>
                                <p class="text-slate-400 text-xs uppercase tracking-wider font-semibold mb-1">Card</p>
                                <p class="text-white font-mono">@transactionResult.CardNum</p>
                                <p class="text-slate-300 text-sm mt-1">@transactionResult.OwnerName</p>
                            </div>
                            <div class="text-right">
                                <p class="text-slate-400 text-xs uppercase tracking-wider font-semibold mb-1">Deducted</p>
                                <p class="text-rose-400 font-bold text-xl">-@transactionResult.Amount.ToString("N0") MMK</p>
                            </div>
                        </div>
                        
                        <div class="pt-4 border-t border-white/10 flex justify-between items-center">
                            <p class="text-slate-400 text-sm">Terminal</p>
                            <p class="text-white font-mono text-sm">@transactionResult.TerminalSerialNo</p>
                        </div>

                        <div class="pt-4 flex justify-between items-center text-xs text-slate-500">
                            <span>Remaining Balance</span>
                            <span class="font-bold text-white text-base">@transactionResult.RemainingBalance.ToString("N0") MMK</span>
                        </div>
                    </div>
                </div>
            }

            <div class="space-y-6">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Card Number <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <span class="bi bi-credit-card-2-front"></span>
                        </span>
                        @if (isCardBound)
                        {
                            <input class="w-full bg-slate-100 border border-slate-200 text-slate-500 rounded-xl pl-10 pr-4 py-3 cursor-not-allowed text-sm font-mono tracking-widest" 
                                   type="text" value="@request.CardNum" readonly />
                        }
                        else
                        {
                            <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm font-mono tracking-widest" 
                                   type="text" maxlength="50" @bind="request.CardNum" placeholder="Scan or enter card number" />
                        }
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Terminal Serial Number <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <span class="bi bi-terminal"></span>
                        </span>
                        <input class="w-full bg-white border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm font-mono" 
                               type="text" maxlength="100" @bind="request.TerminalSerialNo" placeholder="Enter terminal serial no" />
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-slate-100">
                    <button class="flex-1 py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl shadow-sm transition-all duration-200 disabled:opacity-50 text-lg flex items-center justify-center gap-2" @onclick="ShowPayConfirm" disabled="@isSaving">
                        <span class="bi bi-wifi transform rotate-90"></span>
                        @(isSaving ? "Processing..." : "Pay 400 Kyats")
                    </button>
                    <NavLink class="px-6 py-4 bg-white hover:bg-slate-50 text-slate-700 font-medium rounded-xl border border-slate-200 shadow-sm transition-all duration-200 text-center flex items-center justify-center" href="/transactions">
                        History
                    </NavLink>
                </div>
            </div>
        </div>
    </div>
</div>

@if (showPayConfirm)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" @onclick="CancelPay"></div>
        <div class="relative bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-sm p-6">
            <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
                    <span class="bi bi-credit-card text-emerald-600"></span>
                </div>
                <div class="flex-1">
                    <h3 class="text-base font-semibold text-neutral-900">Confirm payment</h3>
                    <p class="text-sm text-neutral-500 mt-1">Pay <span class="font-semibold text-neutral-700">400 Kyats</span> for this trip?</p>
                </div>
            </div>
            <div class="flex gap-3 mt-6">
                <button class="flex-1 px-4 py-2.5 rounded-xl text-sm font-medium text-neutral-600 bg-neutral-100 hover:bg-neutral-200 transition-colors" @onclick="CancelPay">Cancel</button>
                <button class="flex-1 px-4 py-2.5 rounded-xl text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 transition-colors disabled:opacity-50" @onclick="ConfirmPay" disabled="@isSaving">@(isSaving ? "Processing..." : "Confirm")</button>
            </div>
        </div>
    </div>
}
