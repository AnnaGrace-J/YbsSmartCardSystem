@page "/transactions"

@inject YbsSmartCardSystem.App.Services.AuthStateService AuthState

<PageHeader Title="Transaction History" Subtitle="View bus payment transactions">
    @if (AuthState.HasPermission("BusPayment.Create"))
    {
        <NavLink class="inline-flex items-center gap-2 px-4 py-2 btn-primary text-sm font-medium rounded-xl shadow-sm" href="/transactions/new">
            <span class="bi bi-plus-lg"></span> New Transaction
        </NavLink>
    }
</PageHeader>

<div class="mb-6 bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
    <div class="flex flex-col md:flex-row gap-4">
        <div class="flex-1">
            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Card Number</label>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                    <span class="bi bi-credit-card"></span>
                </span>
                <input class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-2 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm" type="text" maxlength="50" @bind="request.CardNum" @bind:event="oninput" placeholder="Search by Card No..." />
            </div>
        </div>
        <div class="flex-1">
            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Terminal Serial</label>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                    <span class="bi bi-terminal"></span>
                </span>
                <input class="w-full bg-slate-50 border border-slate-200 text-slate-900 rounded-xl pl-10 pr-4 py-2 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all duration-200 text-sm" type="text" maxlength="100" @bind="request.TerminalSerialNo" @bind:event="oninput" placeholder="Search by Terminal..." />
            </div>
        </div>
        <div class="flex items-end gap-2">
            <button class="inline-flex items-center px-4 py-2 btn-primary text-sm font-medium rounded-xl shadow-sm" @onclick="ApplyFilter" disabled="@isLoading">
                Search
            </button>
            <button class="inline-flex items-center px-4 py-2 btn-secondary text-sm font-medium rounded-xl shadow-sm" @onclick="ClearFilter" disabled="@isLoading">
                Clear
            </button>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="flex justify-center items-center py-12">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
    </div>
}
else if (response.IsSuccess)
{
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold tracking-wider">
                    <tr>
                        <th class="px-6 py-4">No</th>
                        <th class="px-6 py-4">Transaction No</th>
                        <th class="px-6 py-4">Card No</th>
                        <th class="px-6 py-4">FullName</th>
                        <th class="px-6 py-4">Terminal</th>
                        <th class="px-6 py-4">Bus No</th>
                        <th class="px-6 py-4">Bus License</th>
                        <th class="px-6 py-4 text-right">Amount</th>
                        <th class="px-6 py-4">Date</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (response.Data is not null)
                    {
                        int rowNo = (request.PageNo - 1) * request.PageSize;
                        @foreach (var item in response.Data.Transactions)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4 text-slate-400 whitespace-nowrap">@(++rowNo)</td>
                                <td class="px-6 py-4 font-mono text-slate-900 whitespace-nowrap">@item.TransactionNo</td>
                                <td class="px-6 py-4 font-mono text-slate-900 whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        @item.CardNum
                                        <button class="inline-flex items-center justify-center h-6 w-6 rounded border transition-all duration-200 active:scale-95 shadow-sm @(copiedItem == $"tx-{item.TransactionId}" ? "bg-emerald-50 border-emerald-200 text-emerald-600" : "bg-blue-50 border-blue-200 text-blue-600 hover:bg-blue-50/50 hover:border-blue-300")"
                                                @onclick="@(() => CopyText($"tx-{item.TransactionId}", item.CardNum))"
                                                title="Copy card number">
                                            <span class="bi @(copiedItem == $"tx-{item.TransactionId}" ? "bi-check" : "bi-copy") text-[10px]"></span>
                                        </button>
                                    </div>
                                </td>
                                <td class="px-6 py-4 font-medium text-slate-900 whitespace-nowrap">@item.OwnerName</td>
                                <td class="px-6 py-4 text-slate-500 whitespace-nowrap">@item.TerminalSerialNo</td>
                                <td class="px-6 py-4 font-medium text-slate-700 whitespace-nowrap">@item.BusNo</td>
                                <td class="px-6 py-4 text-slate-500 whitespace-nowrap">@item.BusLicense</td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <span class="font-bold text-rose-600">-@item.Amount.ToString("N0")</span>
                                    <span class="text-slate-400 text-xs ml-1">MMK</span>
                                </td>
                                <td class="px-6 py-4 text-slate-500 whitespace-nowrap">@item.TransactionDate.ToString("dd-MM-yyyy hh:mm tt")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (response.Data is not null)
        {
            <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="text-sm text-slate-500">
                    Total: <strong class="text-slate-900 font-semibold">@response.Data.TotalCount</strong> records &middot; 10 per page
                </div>
                <div class="flex items-center gap-2">
                    <button class="inline-flex items-center px-3 py-1.5 btn-secondary text-sm font-medium rounded-lg shadow-sm" @onclick="() => ChangePage(request.PageNo - 1)" disabled="@(request.PageNo <= 1)">
                        Previous
                    </button>
                    <span class="text-sm text-slate-600 font-medium px-2">Page @request.PageNo of @TotalPages</span>
                    <button class="inline-flex items-center px-3 py-1.5 btn-secondary text-sm font-medium rounded-lg shadow-sm" @onclick="() => ChangePage(request.PageNo + 1)" disabled="@(request.PageNo >= TotalPages)">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrWhiteSpace(response.Message))
{
    <div class="mb-6 p-4 rounded-xl bg-rose-50 text-rose-700 text-sm border border-rose-200 flex items-center gap-2">
        <span class="bi bi-exclamation-triangle"></span> @response.Message
    </div>
}
