@inherits LayoutComponentBase
@inject YbsSmartCardSystem.App.Services.AuthStateService AuthState
@inject NavigationManager NavManager
@implements IDisposable

<div class="min-h-screen bg-surface-container-low flex flex-col @(_sidebarOpen ? "md:flex-row" : "") font-sans">
    
    <!-- Sidebar -->
    @if (_sidebarOpen)
    {
        <aside class="relative w-full md:w-64 bg-gradient-to-b from-[#e2e9f7] via-[#ccd8ee] to-[#aebdde] border-r border-neutral-200/80 flex-shrink-0 md:min-h-screen flex flex-col overflow-hidden transition-all">
            <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
                <div class="absolute bottom-0 -left-24 w-72 h-72 rounded-full bg-sky-200/60 blur-3xl"></div>
            </div>
            <div class="relative flex flex-col min-h-0 flex-1">
                <NavMenu />
            </div>
        </aside>
    }

    <!-- Main Content -->
    <div class="flex-1 flex flex-col min-w-0">
        <!-- Top Header -->
        <header class="relative h-16 flex items-center justify-between px-6 shrink-0 sticky top-0 z-10 bg-gradient-to-r from-[#fbfcfe] via-[#f2f5fa] to-[#e9edf6] border-b border-neutral-200/80 shadow-[0_1px_12px_rgba(15,23,42,0.08)]">
            <div class="absolute bottom-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-amber-400/70 to-transparent pointer-events-none" aria-hidden="true"></div>
            <div class="flex items-center gap-3 flex-1 min-w-0">
                <button class="btn-ghost flex items-center justify-center w-9 h-9 rounded-lg text-neutral-600 hover:text-neutral-900 hover:bg-neutral-200/70" @onclick="ToggleSidebar" aria-label="Toggle sidebar">
                    <span class="bi bi-list text-2xl"></span>
                </button>
                <div class="text-neutral-900 font-medium truncate">
                    @if (AuthState.IsAuthenticated)
                    {
                        <span class="text-[11px] text-neutral-500 uppercase tracking-wider font-medium">Welcome back,</span>
                        <span class="ml-2 text-sm font-semibold text-neutral-900">@AuthState.CurrentUser?.UserName</span>
                    }
                </div>
            </div>
            <div class="flex items-center gap-4 pl-4 border-l border-neutral-200/80">
                @if (AuthState.IsAuthenticated)
                {
                    <div class="relative">
                        <div class="absolute -inset-[3px] rounded-full bg-gradient-to-tr from-amber-400 via-orange-400 to-rose-500 opacity-50 blur-[5px]" aria-hidden="true"></div>
                        <span class="relative inline-flex items-center justify-center h-9 w-9 rounded-full bg-gradient-to-br from-[#2a3450] to-[#20283c] text-white border border-white/60 font-semibold text-xs shadow-md">
                            @(AuthState.CurrentUser?.UserName?.FirstOrDefault() ?? 'U')
                        </span>
                        <span class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-emerald-500 border-2 border-white"></span>
                    </div>
                }
            </div>
        </header>

        <!-- Page Content -->
        <main class="flex-1 overflow-y-auto p-4 md:p-8">
            <article class="max-w-7xl mx-auto w-full">
                @Body
            </article>
        </main>
    </div>
</div>

<div id="blazor-error-ui" class="hidden">
    An unhandled error has occurred.
    <a href="" class="reload text-blue-500">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _sidebarOpen = true;
    private bool _redirectToLoginAfterRender;

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    protected override void OnInitialized()
    {
        AuthState.OnChange += StateHasChanged;
        NavManager.LocationChanged += OnLocationChanged;
        _redirectToLoginAfterRender = ShouldRedirectToLogin();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _redirectToLoginAfterRender)
        {
            _redirectToLoginAfterRender = false;
            NavManager.NavigateTo("/login");
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CheckAuthentication();
    }

    private void CheckAuthentication()
    {
        if (ShouldRedirectToLogin())
        {
            NavManager.NavigateTo("/login");
        }
    }

    private bool ShouldRedirectToLogin()
    {
        var relativePath = NavManager.ToBaseRelativePath(NavManager.Uri);
        var queryIndex = relativePath.IndexOf('?');
        if (queryIndex >= 0)
        {
            relativePath = relativePath[..queryIndex];
        }
        
        relativePath = relativePath.TrimEnd('/');

        return !AuthState.IsAuthenticated &&
            !relativePath.Equals("login", StringComparison.OrdinalIgnoreCase) &&
            !relativePath.Equals("register", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        AuthState.OnChange -= StateHasChanged;
        NavManager.LocationChanged -= OnLocationChanged;
    }
}
