@inherits LayoutComponentBase
@inject YbsSmartCardSystem.App.Services.AuthStateService AuthState
@inject NavigationManager NavManager
@implements IDisposable

<div class="min-h-screen bg-slate-50 flex flex-col md:flex-row font-sans">
    
    <!-- Sidebar -->
    <aside class="w-full md:w-64 bg-slate-900 border-r border-slate-800 flex-shrink-0 md:min-h-screen flex flex-col transition-all">
        <NavMenu />
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col min-w-0">
        <!-- Top Header -->
        <header class="bg-white border-b border-slate-200 h-16 flex items-center justify-between px-6 shrink-0 sticky top-0 z-10 shadow-sm">
            <div class="text-slate-800 font-medium truncate flex-1">
                @if (AuthState.IsAuthenticated)
                {
                    <span class="text-sm text-slate-500">Welcome back,</span>
                    <span class="ml-1 font-semibold">@AuthState.CurrentUser?.UserName</span>
                }
            </div>
            <div class="flex items-center gap-4 pl-4 border-l border-slate-100">
                @if (AuthState.IsAuthenticated)
                {
                    <span class="inline-flex items-center justify-center h-9 w-9 rounded-xl bg-gradient-to-tr from-blue-500 to-indigo-500 text-white font-bold text-sm shadow-md shadow-blue-500/20">
                        @(AuthState.CurrentUser?.UserName?.FirstOrDefault() ?? 'U')
                    </span>
                }
            </div>
        </header>

        <!-- Page Content -->
        <main class="flex-1 overflow-y-auto p-4 md:p-8">
            <article class="max-w-7xl mx-auto w-full">
                @Body
            </article>
        </main>
    </div>
</div>

<div id="blazor-error-ui" class="hidden">
    An unhandled error has occurred.
    <a href="" class="reload text-blue-500">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _redirectToLoginAfterRender;

    protected override void OnInitialized()
    {
        AuthState.OnChange += StateHasChanged;
        NavManager.LocationChanged += OnLocationChanged;
        _redirectToLoginAfterRender = ShouldRedirectToLogin();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _redirectToLoginAfterRender)
        {
            _redirectToLoginAfterRender = false;
            NavManager.NavigateTo("/login");
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CheckAuthentication();
    }

    private void CheckAuthentication()
    {
        if (ShouldRedirectToLogin())
        {
            NavManager.NavigateTo("/login");
        }
    }

    private bool ShouldRedirectToLogin()
    {
        var relativePath = NavManager.ToBaseRelativePath(NavManager.Uri);
        var queryIndex = relativePath.IndexOf('?');
        if (queryIndex >= 0)
        {
            relativePath = relativePath[..queryIndex];
        }
        
        relativePath = relativePath.TrimEnd('/');

        return !AuthState.IsAuthenticated &&
            !relativePath.Equals("login", StringComparison.OrdinalIgnoreCase) &&
            !relativePath.Equals("register", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        AuthState.OnChange -= StateHasChanged;
        NavManager.LocationChanged -= OnLocationChanged;
    }
}
