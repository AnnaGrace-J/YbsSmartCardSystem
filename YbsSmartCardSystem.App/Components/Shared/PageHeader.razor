<div class="mb-4 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
        <h1 class="text-xl font-bold text-neutral-900 tracking-tight">@Title</h1>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p class="mt-1 text-[11px] font-medium text-neutral-500">@Subtitle</p>
        }
    </div>
    @if (ChildContent != null)
    {
        <div class="flex items-center gap-3">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
