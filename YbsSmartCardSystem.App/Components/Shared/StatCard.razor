<div class="bg-white border border-neutral-200/80 rounded-md p-3 flex flex-col justify-between transition-all duration-150 shadow-xs hover:border-neutral-300">
    <div class="flex items-center justify-between mb-2">
        <h3 class="text-[10px] font-semibold text-neutral-500 uppercase tracking-wider">@Title</h3>
        @if (!string.IsNullOrEmpty(IconClass))
        {
            <div class="w-7 h-7 rounded-md bg-neutral-100 text-neutral-600 flex items-center justify-center">
                <span class="@IconClass text-xs leading-none"></span>
            </div>
        }
    </div>
    <div>
        <div class="text-lg font-bold text-neutral-900 tracking-tight">@Value</div>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <div class="text-[11px] text-neutral-400 mt-0.5 font-medium">@Subtitle</div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string IconClass { get; set; } = "";
}
