<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold tracking-wide @GetColorClasses()">
    @if (!string.IsNullOrEmpty(IconClass))
    {
        <span class="@IconClass mr-1.5 text-[10px]"></span>
    }
    @Text
</span>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Type { get; set; } = "neutral";
    [Parameter] public string IconClass { get; set; } = "";

    private string GetColorClasses()
    {
        return Type.ToLowerInvariant() switch
        {
            "success" => "bg-emerald-100 text-emerald-800",
            "warning" => "bg-amber-100 text-amber-800",
            "danger" => "bg-rose-100 text-rose-800",
            "info" => "bg-blue-100 text-blue-800",
            "credit" => "bg-teal-50 text-teal-700 border border-teal-200/60",
            "debit" => "bg-slate-50 text-slate-700 border border-slate-200/60",
            _ => "bg-slate-100 text-slate-800"
        };
    }
}
